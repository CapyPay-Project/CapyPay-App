PUBLIC_API_URL=/api

# Supabase (frontend Astro)
# Se aceptan prefijos PUBLIC_ y NEXT_PUBLIC_.
PUBLIC_SUPABASE_URL=https://xaxomdcycavhuwafbpun.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace_with_publishable_key
NEXT_PUBLIC_SUPABASE_URL=https://xaxomdcycavhuwafbpun.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=replace_with_publishable_key

# Sesion cliente (Fase 3.2)
# Renueva token automaticamente cuando faltan <= N minutos para expirar.
PUBLIC_SESSION_REFRESH_WINDOW_MINUTES=15

# Enfriamiento minimo entre renovaciones automaticas.
PUBLIC_SESSION_REFRESH_COOLDOWN_SECONDS=60

# Cada cuanto revisar si hace falta renovar token.
PUBLIC_SESSION_REFRESH_POLL_SECONDS=60

# Tiempo de aviso visual antes de redirigir a login por sesion invalida (ms).
PUBLIC_SESSION_NOTICE_DELAY_MS=900
