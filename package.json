{
  "name": "capypay-app",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})\" && astro dev",
    "build": "astro build",
    "build:quick": "astro build --devOutput",
    "build:profile": "node ./scripts/profile-build.mjs",
    "check:quick": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "e2e:smoke": "npm run build && playwright test --config=playwright.config.ts tests/e2e/sprint5_2.smoke.spec.ts",
    "e2e:smoke:headed": "npm run build && playwright test --config=playwright.config.ts tests/e2e/sprint5_2.smoke.spec.ts --headed"
  },
  "dependencies": {
    "@astrojs/svelte": "^8.0.5",
    "@formkit/auto-animate": "^0.9.0",
    "@lucide/astro": "^1.7.0",
    "@nanostores/query": "^0.3.4",
    "@phosphor-icons/web": "^2.1.2",
    "@supabase/supabase-js": "^2.100.1",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^6.1.9",
    "canvas-confetti": "^1.9.4",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "leaflet": "^1.9.4",
    "lucide-astro": "^0.556.0",
    "lucide-svelte": "^1.0.1",
    "nanostores": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.55.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@playwright/test": "^1.58.2",
    "@types/canvas-confetti": "^1.9.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "^2.8.3"
    }
  }
}
