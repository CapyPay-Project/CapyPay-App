---
/**
 * Sidebar.astro
 * Rediseño visual inspirado en referencia de usuario con dos variantes:
 * - light: texto/iconos claros sobre panel violeta
 * - dark: texto/iconos oscuros sobre panel violeta
 */
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/dashboard", label: "Inicio", icon: "home" },
  { href: "/finance/history", label: "Historial", icon: "bar_chart" },
  { href: "/finance/recarga", label: "Recarga", icon: "account_balance_wallet" },
  { href: "/services/ticketbus", label: "Pasaje", icon: "confirmation_number" },
  { href: "/services/comedor", label: "Comedor", icon: "restaurant" },
  { href: "/services/cantina", label: "Cantina", icon: "storefront" },
  { href: "/account/ranking", label: "Clasificación", icon: "emoji_events" },
];
---

<aside class="hidden lg:flex capy-sidebar sticky top-0 h-full w-88 flex-col z-40">
  <div class="capy-sidebar-inner h-full w-full flex flex-col">
    <div class="capy-sidebar-logo-wrap">
      <img
        src="/assets/landing/vectors/logocapinamedside.svg"
        alt="Logo de CapyPay"
        class="capy-sidebar-logo"
        loading="eager"
        decoding="async"
      />
    </div>

    <nav class="flex-1 space-y-4 overflow-y-auto pr-1 custom-scrollbar mt-3">
      {
        navItems.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== "/dashboard" && currentPath.startsWith(item.href));

          return (
            <a
              href={item.href}
              data-astro-prefetch
              class={`capy-nav-item ${isActive ? "is-active" : ""}`}
            >
              <span
                class="material-symbols-outlined capy-nav-icon"
                style={`font-variation-settings: 'FILL' ${isActive ? 0 : 1}, 'wght' 600, 'GRAD' 0, 'opsz' 24;`}
                aria-hidden="true"
              >
                {item.icon}
              </span>
              <span class="capy-nav-label">{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="mt-4 pt-4 border-t border-white/20 capy-sidebar-actions">
      <a href="/account/settings" data-astro-prefetch class="capy-sidebar-action">
        <span class="material-symbols-outlined capy-nav-icon" style="font-variation-settings: 'FILL' 1, 'wght' 600, 'GRAD' 0, 'opsz' 24;" aria-hidden="true">settings</span>
        <span class="capy-nav-label">Configuración</span>
      </a>
      <button type="button" class="capy-sidebar-action capy-sidebar-action-logout" onclick="window.openLogoutModal()">
        <span class="material-symbols-outlined capy-nav-icon" style="font-variation-settings: 'FILL' 1, 'wght' 600, 'GRAD' 0, 'opsz' 24;" aria-hidden="true">logout</span>
        <span class="capy-nav-label">Cerrar sesión</span>
      </button>
    </div>
  </div>
</aside>

<style>
  :global(html) {
    --cp-sidebar-bg-a: #8b5cf6;
    --cp-sidebar-bg-b: #6d28d9;
    --cp-sidebar-border: rgba(0, 0, 0, 0.24);
    --cp-sidebar-glow: rgba(109, 40, 217, 0.34);
    --cp-sidebar-item-bg: rgba(243, 232, 255, 0.86);
    --cp-sidebar-item-border: rgba(255, 255, 255, 0.42);
    --cp-sidebar-item-shadow: rgba(76, 29, 149, 0.2);
    --cp-sidebar-item-text: #2e1a63;
    --cp-sidebar-item-icon: #321c6a;
    --cp-sidebar-active-bg: var(--color-brand-receive, #d7fd49);
    --cp-sidebar-active-text: #181818;
    --cp-sidebar-logo-filter: none;
    --cp-sidebar-btn-bg-size: 142% 118%;
    --cp-sidebar-btn-bg-pos: 54% 50%;
  }

  :global(html[data-sidebar-theme="dark"]) {
    --cp-sidebar-bg-a: #a78bfa;
    --cp-sidebar-bg-b: #7c3aed;
    --cp-sidebar-border: rgba(0, 0, 0, 0.18);
    --cp-sidebar-glow: rgba(124, 58, 237, 0.28);
    --cp-sidebar-item-bg: rgba(238, 232, 255, 0.34);
    --cp-sidebar-item-border: rgba(255, 255, 255, 0.26);
    --cp-sidebar-item-shadow: rgba(76, 29, 149, 0.24);
    --cp-sidebar-item-text: #fdfbff;
    --cp-sidebar-item-icon: #fdfbff;
    --cp-sidebar-active-bg: var(--color-brand-receive, #d7fd49);
    --cp-sidebar-active-text: #181818;
    --cp-sidebar-logo-filter: brightness(0) invert(1);
  }

  .capy-sidebar-inner {
    border-radius: 16px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-right: 1px solid var(--cp-sidebar-border);
    border-left: 0;
    border-top: 0;
    border-bottom: 0;
    background:
      radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.18), transparent 42%),
      linear-gradient(170deg, var(--cp-sidebar-bg-a), var(--cp-sidebar-bg-b));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
    padding: 18px 14px;
    overflow: hidden;
  }

  .capy-sidebar {
    padding: 10px 0 10px 12px;
  }

  .capy-sidebar-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 8px 10px 22px;
    margin-bottom: 4px;
  }

  .capy-sidebar-logo {
    width: 176px;
    height: auto;
    filter: var(--cp-sidebar-logo-filter);
    transition: filter 220ms ease;
    transform-origin: left center;
    transform: scale(1.06);
  }

  .capy-nav-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    min-height: 66px;
    border: 0;
    background: transparent;
    box-shadow: none;
    color: var(--cp-sidebar-item-text);
    padding: 0 40px;
    font-weight: 650;
    font-size: 0.96rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    position: relative;
    isolation: isolate;
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .capy-nav-item::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/assets/boton1.svg") no-repeat var(--cp-sidebar-btn-bg-pos) / var(--cp-sidebar-btn-bg-size);
    z-index: -1;
    pointer-events: none;
  }

  .capy-nav-icon {
    color: var(--cp-sidebar-item-icon);
    font-size: 18px;
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    flex-shrink: 0;
    transition: color 160ms ease;
  }

  .capy-nav-label {
    line-height: 1.1;
    transform: translateY(0.25px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .capy-nav-item:hover {
    transform: translateY(-1px);
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.25));
  }

  .capy-nav-item:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.86);
    outline-offset: 2px;
  }

  .capy-nav-item.is-active {
    background: transparent;
    color: var(--cp-sidebar-active-text);
    box-shadow: none;
  }

  .capy-nav-item.is-active::before {
    background: url("/assets/bton2.svg") no-repeat var(--cp-sidebar-btn-bg-pos) / var(--cp-sidebar-btn-bg-size);
  }

  .capy-nav-item.is-active .capy-nav-icon {
    color: var(--cp-sidebar-active-text);
  }

  .capy-sidebar-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .capy-sidebar-action {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 9px;
    min-height: 48px;
    width: 100%;
    border: 0;
    background: transparent;
    box-shadow: none;
    color: var(--cp-sidebar-item-text);
    padding: 0 24px;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    text-align: left;
    text-decoration: none;
    position: relative;
    isolation: isolate;
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .capy-sidebar-action::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/assets/boton1.svg") no-repeat var(--cp-sidebar-btn-bg-pos) / var(--cp-sidebar-btn-bg-size);
    z-index: -1;
    pointer-events: none;
  }

  .capy-sidebar-action:hover {
    transform: translateY(-1px);
    filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.25));
  }

  .capy-sidebar-action:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.86);
    outline-offset: 2px;
  }

  .capy-sidebar-action .capy-nav-label {
    font-size: 0.78rem;
    line-height: 1.05;
    transform: translateY(0.25px);
  }
</style>
