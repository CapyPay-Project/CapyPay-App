---
const quickNavItems = [
  { href: "/dashboard", label: "Inicio", icon: "dashboard", key: "dashboard" },
  { href: "/finance/history", label: "Historial", icon: "history", key: "history" },
  { href: "/account/profile", label: "Perfil", icon: "person", key: "profile" },
  { href: "/account/settings", label: "Ajustes", icon: "settings", key: "settings" },
];

const extendedNavItems = [
  { href: "/finance/recarga", label: "Billetera", icon: "account_balance" },
  { href: "/services/comedor", label: "Comedor", icon: "restaurant" },
  { href: "/services/ticketbus", label: "Pasajes", icon: "confirmation_number" },
  { href: "/services/cantina", label: "Cantina", icon: "storefront" },
  { href: "/account/ranking", label: "Clasificacion", icon: "emoji_events" },
];

---

<div class="md:hidden fixed inset-x-0 bottom-0 z-50 pointer-events-none">
  <div
    id="mobile-nav-backdrop"
    class="hidden absolute inset-0 bg-black/32 backdrop-blur-[2px] pointer-events-auto opacity-0 transition-opacity duration-200"
  ></div>

  <section
    id="mobile-nav-panel"
    class="hidden absolute left-0 right-0 bottom-[calc(env(safe-area-inset-bottom,0px)+76px)] bg-[#FFF9F0] border-t-4 border-black shadow-[0_-4px_12px_rgba(0,0,0,0.14)] p-3 pointer-events-auto max-h-[62vh] overflow-y-auto opacity-0 translate-y-4 transition-[opacity,transform] duration-220"
    aria-label="Menu ampliado"
  >
    <div class="w-12 h-1 rounded-full bg-black/35 mx-auto mb-2" aria-hidden="true"></div>
    <p class="text-[10px] font-black uppercase tracking-widest text-black/70 mb-2 px-1">Mas funciones</p>
    <div class="grid grid-cols-2 gap-2 max-w-xl mx-auto">
      {
        extendedNavItems.map((item) => (
          <a
            href={item.href}
            data-astro-prefetch
            class="mobile-nav-panel-link flex items-center gap-2 border-2 border-black bg-white px-3 py-2 font-black uppercase text-[11px] tracking-wide hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all"
            data-nav-link
          >
            <span class="material-symbols-outlined text-[18px]">{item.icon}</span>
            <span class="truncate">{item.label}</span>
          </a>
        ))
      }
      <button
        id="mobile-nav-logout"
        class="col-span-2 flex items-center justify-center gap-2 border-2 border-black bg-[#ff4d4d] text-white px-3 py-2 font-black uppercase text-[11px] tracking-wide hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all"
        type="button"
      >
        <span class="material-symbols-outlined text-[18px]">logout</span>
        Cerrar sesion
      </button>
    </div>
  </section>

  <nav
    id="mobile-bottom-nav"
    class="relative w-full bg-[#FFF9F0] border-t-4 border-black px-2 pt-4 pb-[calc(env(safe-area-inset-bottom,0px)+10px)] shadow-[0_-3px_10px_rgba(0,0,0,0.13)] pointer-events-auto"
  >
    <div class="grid grid-cols-4 gap-1 items-end">
      {
        quickNavItems.map((item) => (
          <a
            href={item.href}
            data-astro-prefetch
            class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 rounded-sm text-black hover:bg-black hover:text-[#d7fd48] transition-colors min-h-12 px-1"
            data-nav={item.key}
          >
            <span class="material-symbols-outlined text-[20px] leading-none">{item.icon}</span>
            <span class="text-[9px] font-black uppercase tracking-[0.04em] leading-none truncate max-w-full">{item.label}</span>
          </a>
        ))
      }
    </div>

    <button
      id="mobile-nav-more-btn"
      class="absolute left-1/2 -translate-x-1/2 -top-7 w-13 h-13 bg-[#d7fd48] border-4 border-black shadow-[0_4px_0px_0px_rgba(0,0,0,1)] rounded-full flex flex-col items-center justify-center gap-0 text-black hover:brightness-95 transition-all"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="material-symbols-outlined text-[16px] leading-none">menu_open</span>
      <span class="text-[8px] font-black uppercase tracking-[0.04em] leading-none">Mas</span>
    </button>
  </nav>
</div>

<style>
  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 20px);
  }

  .mobile-nav-item.active {
    background: #111827;
    color: #d7fd48;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    const quickItems = document.querySelectorAll("a.mobile-nav-item");
    quickItems.forEach((item) => {
      const itemPath = item.getAttribute("href")?.replace(/\/$/, "") || "";
      if (currentPath === itemPath) {
        item.classList.add("active");
      }
    });

    const moreBtn = document.getElementById("mobile-nav-more-btn");
    const panel = document.getElementById("mobile-nav-panel");
    const backdrop = document.getElementById("mobile-nav-backdrop");
    const logoutBtn = document.getElementById("mobile-nav-logout");
    const bottomNav = document.getElementById("mobile-bottom-nav");

    if (!moreBtn || !panel || !backdrop) return;

    let closeTimer;
    let navTouchStartY = 0;
    let navTouchStartX = 0;
    let panelTouchStartY = 0;
    let panelTouchStartX = 0;

    const clearCloseTimer = () => {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = undefined;
      }
    };

    const closePanel = () => {
      clearCloseTimer();
      panel.classList.add("opacity-0", "translate-y-4");
      backdrop.classList.add("opacity-0");
      moreBtn.setAttribute("aria-expanded", "false");
      moreBtn.classList.remove("!bg-black", "!text-[#d7fd48]");

      closeTimer = window.setTimeout(() => {
        panel.classList.add("hidden");
        backdrop.classList.add("hidden");
      }, 220);
    };

    const openPanel = () => {
      clearCloseTimer();
      panel.classList.remove("hidden");
      backdrop.classList.remove("hidden");
      moreBtn.setAttribute("aria-expanded", "true");
      moreBtn.classList.add("!bg-black", "!text-[#d7fd48]");

      requestAnimationFrame(() => {
        panel.classList.remove("opacity-0", "translate-y-4");
        backdrop.classList.remove("opacity-0");
      });
    };

    moreBtn.addEventListener("click", () => {
      const isOpen = !panel.classList.contains("hidden");
      if (isOpen) closePanel();
      else openPanel();
    });

    backdrop.addEventListener("click", closePanel);
    panel.querySelectorAll("[data-nav-link]").forEach((link) => {
      link.addEventListener("click", closePanel);
    });

    bottomNav?.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.touches[0];
        navTouchStartY = touch.clientY;
        navTouchStartX = touch.clientX;
      },
      { passive: true },
    );

    bottomNav?.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];
        const deltaY = touch.clientY - navTouchStartY;
        const deltaX = touch.clientX - navTouchStartX;

        // Swipe hacia arriba desde la barra inferior abre el panel.
        if (deltaY < -42 && Math.abs(deltaX) < 48 && panel.classList.contains("hidden")) {
          openPanel();
        }
      },
      { passive: true },
    );

    panel.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.touches[0];
        panelTouchStartY = touch.clientY;
        panelTouchStartX = touch.clientX;
      },
      { passive: true },
    );

    panel.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];
        const deltaY = touch.clientY - panelTouchStartY;
        const deltaX = touch.clientX - panelTouchStartX;

        // Swipe hacia abajo dentro del panel lo cierra.
        if (deltaY > 52 && Math.abs(deltaX) < 56 && !panel.classList.contains("hidden")) {
          closePanel();
        }
      },
      { passive: true },
    );

    logoutBtn?.addEventListener("click", () => {
      closePanel();
      window.dispatchEvent(new CustomEvent("logout-requested"));
    });
  });
</script>
