---
const quickNavItems = [
  { href: "/dashboard", label: "Inicio", icon: "home", key: "dashboard" },
  { href: "/finance/history", label: "Historial", icon: "bar_chart", key: "history" },
  { href: "/finance/recarga", label: "Recarga", icon: "account_balance_wallet", key: "recarga" },
];

const drawerNavItems = [
  { href: "/dashboard", label: "Inicio", icon: "home" },
  { href: "/finance/history", label: "Historial", icon: "bar_chart" },
  { href: "/finance/recarga", label: "Recarga", icon: "account_balance_wallet" },
  { href: "/services/ticketbus", label: "Pasaje", icon: "confirmation_number" },
  { href: "/services/comedor", label: "Comedor", icon: "restaurant" },
  { href: "/services/cantina", label: "Cantina", icon: "storefront" },
  { href: "/account/ranking", label: "Clasificación", icon: "emoji_events" },
];
---

<div class="lg:hidden fixed inset-x-0 bottom-0 z-60 pointer-events-none">
  <div id="mobile-sidebar-backdrop" class="hidden fixed inset-0 bg-black/45 backdrop-blur-[2px] opacity-0 transition-opacity duration-220 pointer-events-auto"></div>

  <aside
    id="mobile-sidebar-drawer"
    class="hidden fixed top-2 left-2 bottom-2 w-[84vw] max-w-[320px] mobile-sidebar-shell pointer-events-auto opacity-0 -translate-x-5 transition-[opacity,transform] duration-220"
    aria-label="Sidebar móvil"
    aria-hidden="true"
  >
    <div class="mobile-sidebar-inner h-full w-full flex flex-col px-3 py-3">
      <div class="mobile-sidebar-head">
        <img
          src="/assets/landing/vectors/logocapinamedside.svg"
          alt="Logo de CapyPay"
          class="mobile-sidebar-logo"
          loading="eager"
          decoding="async"
        />
        <button id="mobile-sidebar-close" type="button" class="mobile-sidebar-close" aria-label="Cerrar menú">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <nav class="flex-1 space-y-3 overflow-y-auto pr-1 custom-scrollbar">
        {
          drawerNavItems.map((item) => (
            <a href={item.href} data-astro-prefetch class="mobile-sidebar-link" data-mobile-sidebar-link>
              <span class="material-symbols-outlined mobile-sidebar-link-icon">{item.icon}</span>
              <span class="mobile-sidebar-link-label">{item.label}</span>
            </a>
          ))
        }
      </nav>

      <div class="mobile-sidebar-actions">
        <a href="/account/settings" data-astro-prefetch class="mobile-sidebar-action">
          <span class="material-symbols-outlined mobile-sidebar-link-icon">settings</span>
          <span class="mobile-sidebar-link-label">Configuración</span>
        </a>
        <button id="mobile-sidebar-logout" type="button" class="mobile-sidebar-action">
          <span class="material-symbols-outlined mobile-sidebar-link-icon">logout</span>
          <span class="mobile-sidebar-link-label">Cerrar sesión</span>
        </button>
      </div>
    </div>
  </aside>

  <nav id="mobile-bottom-nav" class="mobile-bottom-shell pointer-events-auto">
    <div class="mobile-bottom-grid">
      {
        quickNavItems.map((item) => (
          <a href={item.href} data-astro-prefetch class="mobile-bottom-item" data-nav={item.key}>
            <span class="material-symbols-outlined mobile-bottom-icon">{item.icon}</span>
            <span class="mobile-bottom-label">{item.label}</span>
          </a>
        ))
      }
      <button id="mobile-sidebar-open" type="button" class="mobile-bottom-menu" aria-expanded="false" aria-controls="mobile-sidebar-drawer">
        <span class="material-symbols-outlined mobile-bottom-icon">menu</span>
        <span class="mobile-bottom-label">Menu</span>
      </button>
    </div>
  </nav>
</div>

<style>
  :global(html) {
    --cp-sidebar-bg-a: #8b5cf6;
    --cp-sidebar-bg-b: #6d28d9;
    --cp-sidebar-border: rgba(0, 0, 0, 0.24);
    --cp-sidebar-item-bg: rgba(243, 232, 255, 0.86);
    --cp-sidebar-item-border: rgba(255, 255, 255, 0.42);
    --cp-sidebar-item-shadow: rgba(76, 29, 149, 0.2);
    --cp-sidebar-item-text: #2e1a63;
    --cp-sidebar-item-icon: #321c6a;
    --cp-sidebar-active-bg: var(--color-brand-receive, #d7fd49);
    --cp-sidebar-active-text: #181818;
    --cp-sidebar-logo-filter: none;
  }

  :global(html[data-sidebar-theme="dark"]) {
    --cp-sidebar-bg-a: #a78bfa;
    --cp-sidebar-bg-b: #7c3aed;
    --cp-sidebar-border: rgba(0, 0, 0, 0.18);
    --cp-sidebar-item-bg: rgba(238, 232, 255, 0.34);
    --cp-sidebar-item-border: rgba(255, 255, 255, 0.26);
    --cp-sidebar-item-shadow: rgba(76, 29, 149, 0.24);
    --cp-sidebar-item-text: #fdfbff;
    --cp-sidebar-item-icon: #fdfbff;
    --cp-sidebar-active-bg: var(--color-brand-receive, #d7fd49);
    --cp-sidebar-active-text: #181818;
    --cp-sidebar-logo-filter: brightness(0) invert(1);
  }

  .mobile-sidebar-shell {
    border-radius: 18px;
    border: 1px solid var(--cp-sidebar-border);
    background:
      radial-gradient(circle at 14% 9%, rgba(255, 255, 255, 0.2), transparent 42%),
      linear-gradient(170deg, var(--cp-sidebar-bg-a), var(--cp-sidebar-bg-b));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 16px 36px rgba(50, 33, 109, 0.28);
    overflow: hidden;
  }

  .mobile-sidebar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 4px 18px;
  }

  .mobile-sidebar-logo {
    width: 106px;
    height: auto;
    filter: var(--cp-sidebar-logo-filter);
  }

  .mobile-sidebar-close {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--cp-sidebar-item-border);
    background: var(--cp-sidebar-item-bg);
    color: var(--cp-sidebar-item-icon);
    display: grid;
    place-items: center;
  }

  .mobile-sidebar-link,
  .mobile-sidebar-action {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 50px;
    border-radius: 999px;
    border: 1px solid var(--cp-sidebar-item-border);
    background: var(--cp-sidebar-item-bg);
    box-shadow: 0 7px 14px var(--cp-sidebar-item-shadow);
    color: var(--cp-sidebar-item-text);
    padding: 0 14px;
    text-decoration: none;
    font-weight: 650;
    font-size: 0.97rem;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .mobile-sidebar-link:hover,
  .mobile-sidebar-action:hover {
    transform: translateY(-1px);
    box-shadow: 0 9px 18px var(--cp-sidebar-item-shadow);
  }

  .mobile-sidebar-link.is-active {
    background: var(--cp-sidebar-active-bg);
    color: var(--cp-sidebar-active-text);
    border-color: rgba(99, 111, 28, 0.45);
    box-shadow: 0 9px 20px rgba(96, 120, 22, 0.34);
  }

  .mobile-sidebar-link-icon {
    color: var(--cp-sidebar-item-icon);
    font-size: 20px;
  }

  .mobile-sidebar-link.is-active .mobile-sidebar-link-icon {
    color: var(--cp-sidebar-active-text);
  }

  .mobile-sidebar-link-label {
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mobile-sidebar-logout {
    margin-top: 0;
  }

  .mobile-sidebar-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .mobile-bottom-shell {
    background: rgba(244, 239, 255, 0.96);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(153, 135, 223, 0.42);
    padding: 8px 8px calc(env(safe-area-inset-bottom, 0px) + 8px);
  }

  .mobile-bottom-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }

  .mobile-bottom-item,
  .mobile-bottom-menu {
    min-height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(136, 118, 212, 0.36);
    background: #e5dcff;
    color: #352d57;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(97, 73, 170, 0.16);
  }

  .mobile-bottom-item.is-active,
  .mobile-bottom-menu.is-active {
    background: var(--color-brand-receive, #d7fd49);
    color: #181818;
  }

  .mobile-bottom-icon {
    font-size: 19px;
    line-height: 1;
  }

  .mobile-bottom-label {
    font-size: 0.67rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
  }
</style>

<script>
  // @ts-nocheck
  function initMobileSidebarNav() {
    const root = document.documentElement;
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    const backdrop = document.getElementById("mobile-sidebar-backdrop");
    const drawer = document.getElementById("mobile-sidebar-drawer");
    const openBtn = document.getElementById("mobile-sidebar-open");
    const closeBtn = document.getElementById("mobile-sidebar-close");
    const logoutBtn = document.getElementById("mobile-sidebar-logout");

    if (!backdrop || !drawer || !openBtn || openBtn.dataset.bound === "1") return;
    openBtn.dataset.bound = "1";

    const bottomItems = document.querySelectorAll(".mobile-bottom-item");
    bottomItems.forEach((item) => {
      const href = item.getAttribute("href")?.replace(/\/$/, "") || "";
      if (href && (currentPath === href || (href !== "/dashboard" && currentPath.startsWith(href)))) {
        item.classList.add("is-active");
      }
    });

    const links = drawer.querySelectorAll(".mobile-sidebar-link");
    links.forEach((item) => {
      const href = item.getAttribute("href")?.replace(/\/$/, "") || "";
      if (href && (currentPath === href || (href !== "/dashboard" && currentPath.startsWith(href)))) {
        item.classList.add("is-active");
      }
      item.addEventListener("click", () => closeDrawer());
    });

    /** @type {number | null} */
    let timer = null;

    const clearTimer = () => {
      if (timer) {
        window.clearTimeout(timer);
        timer = null;
      }
    };

    const lockBody = (locked) => {
      document.body.style.overflow = locked ? "hidden" : "";
    };

    const openDrawer = () => {
      clearTimer();
      drawer.classList.remove("hidden");
      backdrop.classList.remove("hidden");
      drawer.setAttribute("aria-hidden", "false");
      openBtn.setAttribute("aria-expanded", "true");
      openBtn.classList.add("is-active");
      lockBody(true);

      requestAnimationFrame(() => {
        drawer.classList.remove("opacity-0", "-translate-x-5");
        backdrop.classList.remove("opacity-0");
      });
    };

    const closeDrawer = () => {
      clearTimer();
      drawer.classList.add("opacity-0", "-translate-x-5");
      backdrop.classList.add("opacity-0");
      drawer.setAttribute("aria-hidden", "true");
      openBtn.setAttribute("aria-expanded", "false");
      openBtn.classList.remove("is-active");
      lockBody(false);

      timer = window.setTimeout(() => {
        drawer.classList.add("hidden");
        backdrop.classList.add("hidden");
      }, 220);
    };

    openBtn.addEventListener("click", () => {
      const isOpen = !drawer.classList.contains("hidden");
      if (isOpen) closeDrawer();
      else openDrawer();
    });

    closeBtn?.addEventListener("click", closeDrawer);
    backdrop.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !drawer.classList.contains("hidden")) {
        closeDrawer();
      }
    });

    logoutBtn?.addEventListener("click", () => {
      closeDrawer();
      if (typeof window.openLogoutModal === "function") {
        window.openLogoutModal();
      } else {
        window.dispatchEvent(new CustomEvent("logout-requested"));
      }
    });

    window.addEventListener("capypay:sidebar-theme-change", () => {
      const theme = String(root.getAttribute("data-sidebar-theme") || "light");
      if (!theme) {
        root.setAttribute("data-sidebar-theme", "light");
      }
    });
  }

  document.addEventListener("astro:page-load", initMobileSidebarNav);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initMobileSidebarNav();
  }
</script>
