---
const quickNavItems = [
  { href: "/dashboard", label: "Inicio", icon: "dashboard", key: "dashboard" },
  { href: "/finance/history", label: "Actividad", icon: "history", key: "history" },
  { href: "/account/profile", label: "Perfil", icon: "person", key: "profile" },
  { href: "/account/settings", label: "Ajustes", icon: "settings", key: "settings" },
];

const extendedNavItems = [
  { href: "/finance/recarga", label: "Billetera", icon: "account_balance" },
  { href: "/services/comedor", label: "Comedor", icon: "restaurant" },
  { href: "/services/ticketbus", label: "Pasajes", icon: "confirmation_number" },
  { href: "/services/cantina", label: "Cantina", icon: "storefront" },
  { href: "/account/ranking", label: "Ranking", icon: "emoji_events" },
];

const quickLeftItems = quickNavItems.slice(0, 2);
const quickRightItems = quickNavItems.slice(2);
---

<div class="md:hidden fixed inset-x-0 bottom-0 z-50 pointer-events-none">
  <div
    id="mobile-nav-backdrop"
    class="hidden absolute inset-0 bg-black/40 backdrop-blur-[2px] pointer-events-auto"
  ></div>

  <section
    id="mobile-nav-panel"
    class="hidden absolute left-0 right-0 bottom-[calc(env(safe-area-inset-bottom,0px)+76px)] bg-[#FFF9F0] border-t-4 border-black shadow-[0_-8px_0px_0px_rgba(0,0,0,1)] p-3 pointer-events-auto max-h-[62vh] overflow-y-auto"
    aria-label="Menu ampliado"
  >
    <p class="text-[10px] font-black uppercase tracking-widest text-black/70 mb-2 px-1">Mas funciones</p>
    <div class="grid grid-cols-2 gap-2 max-w-xl mx-auto">
      {
        extendedNavItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-panel-link flex items-center gap-2 border-2 border-black bg-white px-3 py-2 font-black uppercase text-[11px] tracking-wide hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all"
            data-nav-link
          >
            <span class="material-symbols-outlined text-[18px]">{item.icon}</span>
            <span class="truncate">{item.label}</span>
          </a>
        ))
      }
      <button
        id="mobile-nav-logout"
        class="col-span-2 flex items-center justify-center gap-2 border-2 border-black bg-[#ff4d4d] text-white px-3 py-2 font-black uppercase text-[11px] tracking-wide hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all"
        type="button"
      >
        <span class="material-symbols-outlined text-[18px]">logout</span>
        Cerrar sesion
      </button>
    </div>
  </section>

  <nav
    class="relative w-full bg-[#FFF9F0] border-t-4 border-black px-2 pt-3 pb-[calc(env(safe-area-inset-bottom,0px)+10px)] shadow-[0_-8px_20px_rgba(0,0,0,0.22)] pointer-events-auto"
  >
    <div class="grid grid-cols-5 gap-1 items-end">
      {
        quickLeftItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 rounded-sm text-black hover:bg-black hover:text-[#d7fd48] transition-colors min-h-12"
            data-nav={item.key}
          >
            <span class="material-symbols-outlined text-[20px] leading-none">{item.icon}</span>
            <span class="text-[10px] font-black uppercase tracking-wide">{item.label}</span>
          </a>
        ))
      }

      <div class="min-h-12" aria-hidden="true"></div>

      {
        quickRightItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-item flex flex-col items-center justify-center gap-0.5 rounded-sm text-black hover:bg-black hover:text-[#d7fd48] transition-colors min-h-12"
            data-nav={item.key}
          >
            <span class="material-symbols-outlined text-[20px] leading-none">{item.icon}</span>
            <span class="text-[10px] font-black uppercase tracking-wide">{item.label}</span>
          </a>
        ))
      }
    </div>

    <button
      id="mobile-nav-more-btn"
      class="absolute left-1/2 -translate-x-1/2 -top-7 w-16 h-16 bg-[#d7fd48] border-4 border-black shadow-[0_6px_0px_0px_rgba(0,0,0,1)] rounded-full flex flex-col items-center justify-center gap-0 text-black hover:brightness-95 transition-all"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="material-symbols-outlined text-[20px] leading-none">menu_open</span>
      <span class="text-[10px] font-black uppercase tracking-wide">Mas</span>
    </button>
  </nav>
</div>

<style>
  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 20px);
  }

  .mobile-nav-item.active {
    background: #111827;
    color: #d7fd48;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    const quickItems = document.querySelectorAll("a.mobile-nav-item");
    quickItems.forEach((item) => {
      const itemPath = item.getAttribute("href")?.replace(/\/$/, "") || "";
      if (currentPath === itemPath) {
        item.classList.add("active");
      }
    });

    const moreBtn = document.getElementById("mobile-nav-more-btn");
    const panel = document.getElementById("mobile-nav-panel");
    const backdrop = document.getElementById("mobile-nav-backdrop");
    const logoutBtn = document.getElementById("mobile-nav-logout");

    if (!moreBtn || !panel || !backdrop) return;

    const closePanel = () => {
      panel.classList.add("hidden");
      backdrop.classList.add("hidden");
      moreBtn.setAttribute("aria-expanded", "false");
      moreBtn.classList.remove("!bg-black", "!text-[#d7fd48]");
    };

    const openPanel = () => {
      panel.classList.remove("hidden");
      backdrop.classList.remove("hidden");
      moreBtn.setAttribute("aria-expanded", "true");
      moreBtn.classList.add("!bg-black", "!text-[#d7fd48]");
    };

    moreBtn.addEventListener("click", () => {
      const isOpen = !panel.classList.contains("hidden");
      if (isOpen) closePanel();
      else openPanel();
    });

    backdrop.addEventListener("click", closePanel);
    panel.querySelectorAll("[data-nav-link]").forEach((link) => {
      link.addEventListener("click", closePanel);
    });

    logoutBtn?.addEventListener("click", () => {
      closePanel();
      window.dispatchEvent(new CustomEvent("logout-requested"));
    });
  });
</script>
