---
---

<div id="areas-view">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8 min-w-0">
    <div class="bg-[#d7fd48] border-4 border-black p-4 sm:p-5 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2 py-0.5 border-2 border-black bg-white text-[10px] font-black uppercase tracking-widest">Promo flash</span>
        <span class="text-[10px] font-black uppercase text-black/60">Termina hoy</span>
      </div>
      <h3 class="text-xl font-black uppercase text-black leading-tight">2x1 En Tostones</h3>
      <p class="text-xs font-bold uppercase text-black/70 mt-1">En cantinas participantes</p>
      <button class="mt-3 px-3 py-2 border-2 border-black bg-black text-[#d7fd48] text-xs font-black uppercase tracking-wide">
        Ver detalles
      </button>
    </div>

    <div class="bg-[#8b5cf6] border-4 border-black p-4 sm:p-5 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2 py-0.5 border-2 border-black bg-white text-[10px] font-black uppercase tracking-widest">Exclusivo</span>
        <span class="text-[10px] font-black uppercase text-white/70">Nivel Magister</span>
      </div>
      <h3 class="text-xl font-black uppercase text-white leading-tight">Hasta 25% Off</h3>
      <p class="text-xs font-bold uppercase text-white/80 mt-1">Beneficios por nivel activo</p>
      <button class="mt-3 px-3 py-2 border-2 border-black bg-white text-[#8b5cf6] text-xs font-black uppercase tracking-wide">
        Ver mi nivel
      </button>
    </div>
  </div>

  <section class="mb-8 bg-white border-4 border-black p-5 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-10 h-10 border-2 border-black bg-[#d7fd48] flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6-6 6 6"></path><path d="m6 15 6 6 6-6"></path><path d="M12 3v18"></path></svg>
        </div>
        <div class="min-w-0">
          <h3 class="text-lg font-black uppercase text-black leading-none">Cantina Del Dia</h3>
          <p class="text-[11px] font-black uppercase text-black/60 mt-1">La mas votada por estudiantes</p>
        </div>
      </div>
      <a href="#" class="text-[11px] font-black uppercase underline text-[#8b5cf6] whitespace-nowrap">Ver ranking</a>
    </div>

    <div id="cantina-del-dia" class="border-2 border-black p-3 sm:p-4 bg-[#fff9f0] hover:translate-y-1 hover:shadow-none transition-all cursor-pointer shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col sm:flex-row gap-3 sm:gap-4 min-h-31">
      <div class="relative shrink-0">
        <img id="cantina-del-dia-img" src="https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=400" alt="Cantina del Día" class="w-20 h-20 sm:w-20 sm:h-20 border-2 border-black object-cover" />
        <div class="absolute -top-2 -left-2 w-7 h-7 bg-[#d7fd48] border-2 border-black flex items-center justify-center text-black font-black text-xs">1</div>
      </div>
      <div class="flex-1 min-w-0">
        <h4 id="cantina-del-dia-name" class="text-base sm:text-lg font-black uppercase text-black truncate">Cargando cantina...</h4>
        <p id="cantina-del-dia-faculty" class="text-[11px] font-black uppercase text-black/60 mt-1">Espera un momento</p>
        <div class="mt-2 inline-flex items-center gap-1.5 border-2 border-black bg-white px-2 py-1 text-[10px] font-black uppercase text-black">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="m4.9 4.9 14.2 14.2"></path><path d="m19.1 4.9-14.2 14.2"></path></svg>
          <span id="cantina-del-dia-votes">245</span> votos
        </div>
      </div>
    </div>
  </section>

  <h2 class="text-base sm:text-lg font-black text-black uppercase tracking-widest mb-5">
    Selecciona el area donde deseas comprar
  </h2>

  <div id="areas-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 min-w-0">
    <!-- Las tarjetas de áreas se generan dinámicamente -->
  </div>
</div>
