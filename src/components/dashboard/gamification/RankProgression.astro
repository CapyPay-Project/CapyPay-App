---
// @ts-nocheck
import { Sprout, GraduationCap, BookOpen, BadgeCheck, Crown, Star } from "@lucide/astro";
const { puntosActuales = 1500 } = Astro.props;

const LEVELS = [
  {
    id: 1,
    nombre: 'Novato',
    puntosMin: 0,
    puntosMax: 500,
    color: '#94A3B8',
    colorGlow: '#64748B',
    beneficios: ['Acceso base a recompensas semanales']
  },
  {
    id: 2,
    nombre: 'Bachiller',
    puntosMin: 501,
    puntosMax: 2000,
    color: '#38BDF8',
    colorGlow: '#0284C7',
    beneficios: ['5% de descuento en comedor']
  },
  {
    id: 3,
    nombre: 'Licenciado',
    puntosMin: 2001,
    puntosMax: 5000,
    color: '#A855F7',
    colorGlow: '#7E22CE',
    beneficios: ['10% de descuento en comedor']
  },
  {
    id: 4,
    nombre: 'Magister',
    puntosMin: 5001,
    puntosMax: 10000,
    color: '#22C55E',
    colorGlow: '#15803D',
    beneficios: ['15% de descuento en comedor', 'Acceso VIP']
  },
  {
    id: 5,
    nombre: 'Doctor',
    puntosMin: 10001,
    puntosMax: 20000,
    color: '#F59E0B',
    colorGlow: '#B45309',
    beneficios: ['20% de descuento en comedor', 'Acceso VIP']
  },
  {
    id: 6,
    nombre: 'Capy Legend',
    puntosMin: 20001,
    puntosMax: Infinity,
    color: '#F43F5E',
    colorGlow: '#BE123C',
    beneficios: ['25% de descuento en comedor', 'Acceso VIP', 'Beneficios exclusivos de temporada']
  }
];

function calculateLevel(xp) {
  for (let i = LEVELS.length - 1; i >= 0; i -= 1) {
    const level = LEVELS[i];
    if (xp >= level.puntosMin) {
      const isMaxLevel = level.puntosMax === Infinity;
      const progress = isMaxLevel
        ? 100
        : Math.min(100, ((xp - level.puntosMin) / (level.puntosMax - level.puntosMin)) * 100);
      const nextXp = isMaxLevel ? 0 : Math.max(0, level.puntosMax - xp);

      return {
        ...level,
        progress: Math.round(progress),
        nextXp,
        isMaxLevel
      };
    }
  }

  return LEVELS[0];
}

function getNextLevel(currentLevelId) {
  return LEVELS.find((level) => level.id === (Number(currentLevelId || 1) + 1)) || null;
}

const nivelActualInicial = calculateLevel(puntosActuales);
---

<div class="w-full">
  <article
    id="perfil-card"
    class="relative overflow-hidden border-4 border-black rounded-3xl bg-[#fffdf6] px-4 py-5 sm:px-6 sm:py-6"
    style={`background: linear-gradient(180deg, #fffdf6, ${nivelActualInicial.color}24); box-shadow: 6px 6px 0 0 rgba(0,0,0,1), 0 0 24px ${nivelActualInicial.colorGlow}33;`}
  >
    <div class="absolute inset-x-0 top-0 h-20 opacity-35 pointer-events-none" id="nivel-top-glow" style={`background: linear-gradient(180deg, ${nivelActualInicial.color}55, transparent);`}></div>

    <div class="relative z-10 flex flex-col items-center text-center">
      <div class="mb-3 inline-flex items-center gap-1.5 border-2 border-black bg-[#fffdf6] rounded-full p-1" role="tablist" aria-label="Vista de nivel">
        <button id="switch-current" type="button" class="px-3 py-1 text-[10px] sm:text-xs font-black uppercase rounded-full border-2 border-black bg-black text-white" aria-selected="true">
          Actual
        </button>
        <button id="switch-next" type="button" class="px-3 py-1 text-[10px] sm:text-xs font-black uppercase rounded-full border-2 border-black bg-white text-black" aria-selected="false">
          Siguiente
        </button>
        <button id="switch-all" type="button" class="px-3 py-1 text-[10px] sm:text-xs font-black uppercase rounded-full border-2 border-black bg-white text-black" aria-selected="false">
          Todos
        </button>
      </div>

      <div id="all-levels-picker" class="hidden w-full max-w-lg mb-3 border-2 border-black bg-[#fffdf6] rounded-full px-2 py-1">
        <div class="flex items-center gap-1.5">
          <button id="level-prev" type="button" class="w-7 h-7 border-2 border-black rounded-full bg-white text-black font-black text-xs leading-none">&lt;</button>
          <div id="level-list" class="flex-1 flex items-center gap-1 overflow-x-auto whitespace-nowrap py-0.5"></div>
          <button id="level-next" type="button" class="w-7 h-7 border-2 border-black rounded-full bg-white text-black font-black text-xs leading-none">&gt;</button>
        </div>
      </div>

      <div
        id="nivel-icon-wrap"
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-full border-4 border-black flex items-center justify-center p-3 sm:p-3.5 mb-3"
        style={`background: linear-gradient(135deg, ${nivelActualInicial.color}, ${nivelActualInicial.colorGlow});`}
      >
        <span id="nivel-icon" class="block w-full h-full text-black">
          {nivelActualInicial.id === 1 && <Sprout class="w-full h-full" stroke-width={2.75} />}
          {nivelActualInicial.id === 2 && <GraduationCap class="w-full h-full" stroke-width={2.75} />}
          {nivelActualInicial.id === 3 && <BookOpen class="w-full h-full" stroke-width={2.75} />}
          {nivelActualInicial.id === 4 && <BadgeCheck class="w-full h-full" stroke-width={2.75} />}
          {nivelActualInicial.id === 5 && <Crown class="w-full h-full" stroke-width={2.75} />}
          {nivelActualInicial.id === 6 && <Star class="w-full h-full" stroke-width={2.75} />}
        </span>
      </div>

      <p id="nivel-numero" class="text-2xl sm:text-3xl font-black uppercase tracking-tight leading-none" style={`color:${nivelActualInicial.colorGlow};`}>
        Nivel {nivelActualInicial.id}
      </p>
      <h2 id="nivel-nombre" class="text-lg sm:text-xl font-black uppercase tracking-wide mt-1" style={`color:${nivelActualInicial.color};`}>
        {nivelActualInicial.nombre}
      </h2>
      <p id="nivel-subtitle" class="mt-1 text-[10px] sm:text-xs font-black uppercase text-black border border-black px-2 py-0.5 rounded-full bg-white/80">
        Tu nivel actual
      </p>

      <div class="w-full max-w-md mt-4">
        <div class="h-3 bg-white border-2 border-black rounded-full overflow-hidden">
          <div
            id="progreso-bar"
            class="h-full rounded-full transition-all duration-500 ease-out"
            style={`width:${nivelActualInicial.progress}%;background:linear-gradient(90deg, ${nivelActualInicial.color}, ${nivelActualInicial.colorGlow});`}
          ></div>
        </div>
        <p id="xp-faltante" class="mt-2 text-[11px] sm:text-xs font-black uppercase text-black/80">
          {nivelActualInicial.isMaxLevel ? 'Nivel maximo alcanzado' : `Faltan ${nivelActualInicial.nextXp.toLocaleString('es-VE')} XP para el siguiente nivel`}
        </p>
      </div>

      <section class="w-full mt-5 border-2 border-black bg-[#fffdf6] rounded-2xl px-3 py-3 sm:px-4 sm:py-4">
        <h3 class="text-left text-xs sm:text-sm font-black uppercase tracking-wider text-black mb-2">
          Beneficios del nivel
        </h3>
        <ul id="beneficios-list" class="space-y-1.5">
          {(nivelActualInicial.beneficios || []).map((beneficio) => (
            <li class="flex items-start gap-2 text-left text-[11px] sm:text-sm font-bold text-black">
              <span class="inline-block w-2 h-2 mt-1.5 bg-black rounded-full"></span>
              <span>{beneficio}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>
</div>

<div class="hidden" aria-hidden="true">
  <span id="nivel-icon-template-1"><Sprout class="w-full h-full" stroke-width={2.75} /></span>
  <span id="nivel-icon-template-2"><GraduationCap class="w-full h-full" stroke-width={2.75} /></span>
  <span id="nivel-icon-template-3"><BookOpen class="w-full h-full" stroke-width={2.75} /></span>
  <span id="nivel-icon-template-4"><BadgeCheck class="w-full h-full" stroke-width={2.75} /></span>
  <span id="nivel-icon-template-5"><Crown class="w-full h-full" stroke-width={2.75} /></span>
  <span id="nivel-icon-template-6"><Star class="w-full h-full" stroke-width={2.75} /></span>
</div>

<script type="module" define:vars={{ puntosActuales }}>
  const levels = [
    { id: 1, nombre: 'Novato', puntosMin: 0, puntosMax: 500, color: '#94A3B8', colorGlow: '#64748B', beneficios: ['Acceso base a recompensas semanales'] },
    { id: 2, nombre: 'Bachiller', puntosMin: 501, puntosMax: 2000, color: '#38BDF8', colorGlow: '#0284C7', beneficios: ['5% de descuento en comedor'] },
    { id: 3, nombre: 'Licenciado', puntosMin: 2001, puntosMax: 5000, color: '#A855F7', colorGlow: '#7E22CE', beneficios: ['10% de descuento en comedor'] },
    { id: 4, nombre: 'Magister', puntosMin: 5001, puntosMax: 10000, color: '#22C55E', colorGlow: '#15803D', beneficios: ['15% de descuento en comedor', 'Acceso VIP'] },
    { id: 5, nombre: 'Doctor', puntosMin: 10001, puntosMax: 20000, color: '#F59E0B', colorGlow: '#B45309', beneficios: ['20% de descuento en comedor', 'Acceso VIP'] },
    { id: 6, nombre: 'Capy Legend', puntosMin: 20001, puntosMax: Infinity, color: '#F43F5E', colorGlow: '#BE123C', beneficios: ['25% de descuento en comedor', 'Acceso VIP', 'Beneficios exclusivos de temporada'] }
  ];

  function calculateLevel(xp) {
    for (let i = levels.length - 1; i >= 0; i -= 1) {
      const level = levels[i];
      if (xp >= level.puntosMin) {
        const isMaxLevel = level.puntosMax === Infinity;
        const progress = isMaxLevel
          ? 100
          : Math.min(100, ((xp - level.puntosMin) / (level.puntosMax - level.puntosMin)) * 100);
        const nextXp = isMaxLevel ? 0 : Math.max(0, level.puntosMax - xp);

        return { ...level, progress: Math.round(progress), nextXp, isMaxLevel };
      }
    }

    return levels[0];
  }

  function getNextLevel(currentLevelId) {
    return levels.find((level) => level.id === (Number(currentLevelId || 1) + 1)) || null;
  }

  let currentPuntos = Number(puntosActuales || 0);
  let viewMode = 'current';
  let selectedLevelId = null;
  const iconTemplates = new Map(
    [1, 2, 3, 4, 5, 6]
      .map((id) => {
        const el = document.getElementById(`nivel-icon-template-${id}`);
        return [id, el?.innerHTML || ''];
      })
  );

  function renderBenefits(items = []) {
    const list = document.getElementById('beneficios-list');
    if (!list) return;

    if (!items || items.length === 0) {
      list.innerHTML = `
        <li class="flex items-start gap-2 text-left text-[11px] sm:text-sm font-bold text-black">
          <span class="inline-block w-2 h-2 mt-1.5 bg-black rounded-full"></span>
          <span>Sin beneficios adicionales en este nivel</span>
        </li>
      `;
      return;
    }

    list.innerHTML = items
      .map((item) => `
        <li class="flex items-start gap-2 text-left text-[11px] sm:text-sm font-bold text-black">
          <span class="inline-block w-2 h-2 mt-1.5 bg-black rounded-full"></span>
          <span>${item}</span>
        </li>
      `)
      .join('');
  }

  function setSwitchStyles() {
    const currentBtn = document.getElementById('switch-current');
    const nextBtn = document.getElementById('switch-next');
    const allBtn = document.getElementById('switch-all');
    if (!currentBtn || !nextBtn || !allBtn) return;

    const currentActive = viewMode === 'current';
    const nextActive = viewMode === 'next';
    const allActive = viewMode === 'all';

    currentBtn.setAttribute('aria-selected', currentActive ? 'true' : 'false');
    nextBtn.setAttribute('aria-selected', nextActive ? 'true' : 'false');
    allBtn.setAttribute('aria-selected', allActive ? 'true' : 'false');

    currentBtn.className = `px-3 py-1 text-[10px] sm:text-xs font-black uppercase rounded-full border-2 border-black ${currentActive ? 'bg-black text-white' : 'bg-white text-black'}`;
    nextBtn.className = `px-3 py-1 text-[10px] sm:text-xs font-black uppercase rounded-full border-2 border-black ${nextActive ? 'bg-black text-white' : 'bg-white text-black'}`;
    allBtn.className = `px-3 py-1 text-[10px] sm:text-xs font-black uppercase rounded-full border-2 border-black ${allActive ? 'bg-black text-white' : 'bg-white text-black'}`;
  }

  function renderLevelPicker(currentLevelId) {
    const list = document.getElementById('level-list');
    if (!list) return;

    list.innerHTML = levels
      .map((level) => {
        const isCurrent = Number(level.id) === Number(currentLevelId);
        const isSelected = Number(level.id) === Number(selectedLevelId);
        const isLocked = currentPuntos < Number(level.puntosMin);
        const toneStyle = isSelected
          ? `background:${level.color};color:#000;`
          : isCurrent
            ? 'background:#d7fd48;color:#000;'
            : 'background:#fffdf6;color:#000;';

        return `<button
          type="button"
          data-level-id="${level.id}"
          class="px-2.5 py-1 text-[10px] font-black uppercase border-2 border-black rounded-full ${isLocked ? 'opacity-70' : ''}"
          style="${toneStyle}"
          title="Nivel ${level.id} - ${level.nombre}"
        >N${level.id}</button>`;
      })
      .join('');

    list.querySelectorAll('button[data-level-id]').forEach((button) => {
      button.addEventListener('click', () => {
        selectedLevelId = Number(button.getAttribute('data-level-id') || currentLevelId);
        viewMode = 'all';
        updateUI();
      });
    });
  }

  function updateUI() {
    const current = calculateLevel(currentPuntos);
    if (!current) return;
    const next = getNextLevel(current.id);
    const picked = levels.find((level) => Number(level.id) === Number(selectedLevelId)) || null;
    const displayed = viewMode === 'all'
      ? (picked || current)
      : ((viewMode === 'next' && next) ? next : current);

    const card = document.getElementById('perfil-card');
    const topGlow = document.getElementById('nivel-top-glow');
    const iconWrap = document.getElementById('nivel-icon-wrap');
    const icon = document.getElementById('nivel-icon');
    const numero = document.getElementById('nivel-numero');
    const nombre = document.getElementById('nivel-nombre');
    const subtitle = document.getElementById('nivel-subtitle');
    const progresoBar = document.getElementById('progreso-bar');
    const xpFaltante = document.getElementById('xp-faltante');
    const allLevelsPicker = document.getElementById('all-levels-picker');

    if (card) {
      card.style.background = `linear-gradient(180deg, #fffdf6, ${displayed.color}24)`;
      card.style.boxShadow = `6px 6px 0 0 rgba(0,0,0,1), 0 0 24px ${displayed.colorGlow}33`;
    }

    if (topGlow) {
      topGlow.style.background = `linear-gradient(180deg, ${displayed.color}55, transparent)`;
    }

    if (iconWrap) {
      iconWrap.style.background = `linear-gradient(135deg, ${displayed.color}, ${displayed.colorGlow})`;
    }
    if (icon) icon.innerHTML = iconTemplates.get(Number(displayed.id)) || '';
    if (numero) numero.textContent = `Nivel ${displayed.id}`;
    if (nombre) nombre.textContent = displayed.nombre;

    if (numero) {
      numero.style.color = displayed.colorGlow;
      numero.style.textShadow = `1px 1px 0 rgba(0,0,0,0.12)`;
    }

    if (nombre) {
      nombre.style.color = displayed.color;
      nombre.style.textShadow = `1px 1px 0 rgba(0,0,0,0.12)`;
    }

    if (subtitle) {
      if (viewMode === 'next' && next) {
        subtitle.textContent = 'Siguiente nivel';
      } else if (viewMode === 'all' && Number(displayed.id) !== Number(current.id)) {
        subtitle.textContent = currentPuntos < Number(displayed.puntosMin)
          ? 'Nivel por desbloquear'
          : 'Nivel explorado';
      } else {
        subtitle.textContent = 'Tu nivel actual';
      }

      subtitle.style.background = `${displayed.color}2B`;
    }

    if (progresoBar) {
      let progressForView = current.progress;

      if (viewMode === 'next' && next) {
        progressForView = Math.min(100, Math.round((currentPuntos / next.puntosMin) * 100));
      } else if (viewMode === 'all' && Number(displayed.id) !== Number(current.id)) {
        if (currentPuntos >= Number(displayed.puntosMax || Number.MAX_SAFE_INTEGER)) {
          progressForView = 100;
        } else if (currentPuntos < Number(displayed.puntosMin)) {
          progressForView = Math.min(100, Math.round((currentPuntos / Math.max(1, Number(displayed.puntosMin))) * 100));
        } else {
          progressForView = Math.min(100, Math.round(((currentPuntos - Number(displayed.puntosMin)) / Math.max(1, Number(displayed.puntosMax || Number.MAX_SAFE_INTEGER) - Number(displayed.puntosMin))) * 100));
        }
      }

      progresoBar.style.width = `${progressForView}%`;
      progresoBar.style.background = `linear-gradient(90deg, ${displayed.color}, ${displayed.colorGlow})`;
    }

    if (xpFaltante) {
      if (viewMode === 'next' && next) {
        const toUnlock = Math.max(0, next.puntosMin - currentPuntos);
        xpFaltante.textContent = `Necesitas ${toUnlock.toLocaleString('es-VE')} XP para desbloquearlo`;
      } else if (viewMode === 'all' && Number(displayed.id) !== Number(current.id)) {
        if (currentPuntos < Number(displayed.puntosMin)) {
          const toUnlock = Math.max(0, Number(displayed.puntosMin) - currentPuntos);
          xpFaltante.textContent = `Te faltan ${toUnlock.toLocaleString('es-VE')} XP para este nivel`;
        } else if (currentPuntos >= Number(displayed.puntosMax || Number.MAX_SAFE_INTEGER)) {
          xpFaltante.textContent = 'Ya superaste este nivel';
        } else {
          const toClose = Math.max(0, Number(displayed.puntosMax || Number.MAX_SAFE_INTEGER) - currentPuntos);
          xpFaltante.textContent = `Te faltan ${toClose.toLocaleString('es-VE')} XP para completar este nivel`;
        }
      } else {
        xpFaltante.textContent = current.isMaxLevel
          ? 'Nivel maximo alcanzado'
          : `Faltan ${current.nextXp.toLocaleString('es-VE')} XP para el siguiente nivel`;
      }
    }

    renderBenefits(displayed.beneficios || []);
    renderLevelPicker(current.id);

    if (allLevelsPicker) {
      allLevelsPicker.classList.toggle('hidden', viewMode !== 'all');
    }

    setSwitchStyles();
  }

  function actualizarXP(nuevoXP) {
    currentPuntos = Number(nuevoXP || 0);
    updateUI();
  }

  function initSwitch() {
    const currentBtn = document.getElementById('switch-current');
    const nextBtn = document.getElementById('switch-next');
    const allBtn = document.getElementById('switch-all');
    const prevBtn = document.getElementById('level-prev');
    const nextLevelBtn = document.getElementById('level-next');
    const levelPicker = document.getElementById('all-levels-picker');

    function stepLevel(direction) {
      const current = calculateLevel(currentPuntos);
      if (viewMode !== 'all') {
        viewMode = 'all';
        selectedLevelId = Number(current?.id || 1);
      }

      const index = levels.findIndex((l) => Number(l.id) === Number(selectedLevelId));
      if (direction === 'prev') {
        const prevIndex = index <= 0 ? levels.length - 1 : index - 1;
        selectedLevelId = Number(levels[prevIndex]?.id || selectedLevelId || 1);
      } else {
        const nextIndex = index >= levels.length - 1 || index < 0 ? 0 : index + 1;
        selectedLevelId = Number(levels[nextIndex]?.id || selectedLevelId || 1);
      }
      updateUI();
    }

    if (currentBtn) {
      currentBtn.addEventListener('click', () => {
        viewMode = 'current';
        selectedLevelId = null;
        updateUI();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        viewMode = 'next';
        selectedLevelId = null;
        updateUI();
      });
    }

    if (allBtn) {
      allBtn.addEventListener('click', () => {
        const current = calculateLevel(currentPuntos);
        viewMode = 'all';
        selectedLevelId = Number(selectedLevelId || current?.id || 1);
        updateUI();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        stepLevel('prev');
      });
    }

    if (nextLevelBtn) {
      nextLevelBtn.addEventListener('click', () => {
        stepLevel('next');
      });
    }

    if (levelPicker) {
      let touchStartX = 0;
      let touchStartY = 0;
      const swipeThreshold = 36;
      const verticalTolerance = 26;

      levelPicker.addEventListener('touchstart', (event) => {
        const touch = event.changedTouches?.[0];
        if (!touch) return;
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      }, { passive: true });

      levelPicker.addEventListener('touchend', (event) => {
        if (viewMode !== 'all') return;
        const touch = event.changedTouches?.[0];
        if (!touch) return;

        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;

        if (Math.abs(deltaY) > verticalTolerance) return;
        if (Math.abs(deltaX) < swipeThreshold) return;

        if (deltaX < 0) {
          stepLevel('next');
        } else {
          stepLevel('prev');
        }
      }, { passive: true });
    }
  }

  function initModuloNiveles() {
    initSwitch();
    updateUI();
    window.actualizarXPModulo = actualizarXP;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModuloNiveles);
  } else {
    initModuloNiveles();
  }
</script>
