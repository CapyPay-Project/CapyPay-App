<div
  id="transaction-modal"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-black/60 backdrop-blur-md opacity-0 transition-opacity duration-300 px-4 py-6"
>
  <div
    class="bg-white border-4 border-black shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] w-full max-w-3xl p-6 sm:p-8 m-0 transform scale-95 transition-transform duration-300 relative overflow-hidden max-h-[92vh] overflow-y-auto custom-scrollbar"
    style="font-family: 'Space Grotesk', sans-serif;"
  >
    <div
      class="flex justify-between items-start gap-4 mb-6 border-b-4 border-black pb-4"
    >
      <div class="min-w-0">
        <p
          class="text-[10px] font-black uppercase tracking-[0.35em] text-black/60 mb-1"
        >
          Detalle de movimiento
        </p>
        <h3
          class="text-2xl sm:text-3xl font-black text-black uppercase tracking-tighter"
        >
          TRANSACCIÓN
        </h3>
        <p
          class="text-black/70 text-xs mt-1 font-bold tracking-widest break-all"
          id="modal-id"
        >
          ID: #---
        </p>
      </div>
      <button
        id="close-modal-btn"
        class="p-2 bg-[#d7fd48] border-[3px] border-black text-black hover:-translate-y-1 hover:shadow-none shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-5">
      <div class="space-y-5">
        <div
          class="text-center py-6 bg-[#8CFFE1] border-4 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
        >
          <p
            class="text-black text-xs font-black uppercase tracking-widest mb-1"
          >
            Monto Total
          </p>
          <h2
            class="text-4xl font-black text-black flex justify-center items-center gap-2"
            id="modal-amount"
          >
            $0.00
          </h2>
          <span
            class="inline-block mt-2 px-3 py-1 text-[11px] font-black uppercase tracking-widest border-2 border-black bg-white text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            id="modal-status-badge">Completado</span
          >
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div
            class="bg-gray-100 border-[3px] border-black p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] relative"
          >
            <p
              class="text-black font-black text-[10px] uppercase tracking-widest opacity-60 absolute top-2 right-2"
            >
              Tiempo
            </p>
            <p class="text-black font-black text-xs uppercase mb-1">Fecha</p>
            <p class="text-black text-sm font-bold mt-1" id="modal-date">
              --/--/----
            </p>
          </div>
          <div
            class="bg-gray-100 border-[3px] border-black p-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] relative"
          >
            <p class="text-black font-black text-xs uppercase mb-1">Hora</p>
            <p class="text-black text-sm font-bold mt-1" id="modal-time">
              --:--
            </p>
          </div>
          <div
            class="col-span-2 bg-[#d7fd48] border-[3px] border-black p-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <p
              class="text-black font-black text-[10px] uppercase tracking-widest mb-2 border-b-2 border-black pb-1"
            >
              Concepto / Descripción
            </p>
            <p
              class="text-black text-base font-bold wrap-break-word leading-tight"
              id="modal-desc"
            >
              ---
            </p>
          </div>
        </div>
      </div>

      <div class="space-y-4 lg:self-stretch">
        <div
          class="bg-white border-4 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] p-4 w-full"
        >
          <p
            class="text-[10px] font-black uppercase tracking-[0.3em] text-black/50 mb-3"
          >
            Trazabilidad
          </p>
          <div class="space-y-3 text-sm font-bold text-black">
            <div
              class="flex items-start justify-between gap-4 border-b-2 border-dashed border-black/20 pb-2"
            >
              <span
                class="uppercase text-[11px] font-black tracking-widest text-black/50"
                >Código de rastreo</span
              >
              <span id="modal-tracking" class="text-right wrap-break-word"
                >--</span
              >
            </div>
            <div
              class="flex items-start justify-between gap-4 border-b-2 border-dashed border-black/20 pb-2"
            >
              <span
                class="uppercase text-[11px] font-black tracking-widest text-black/50"
                >Estado</span
              >
              <span id="modal-status-text" class="text-right">--</span>
            </div>
            <div
              class="flex items-start justify-between gap-4 border-b-2 border-dashed border-black/20 pb-2"
            >
              <span
                class="uppercase text-[11px] font-black tracking-widest text-black/50"
                >Tipo</span
              >
              <span id="modal-transfer-type" class="text-right">---</span>
            </div>
            <div class="flex items-start justify-between gap-4">
              <span
                class="uppercase text-[11px] font-black tracking-widest text-black/50"
                >Origen</span
              >
              <span id="modal-source" class="text-right">CapyPay</span>
            </div>
          </div>
        </div>

        <div
          class="bg-[#f8f8ff] border-4 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] p-4 w-full"
        >
          <p
            class="text-[10px] font-black uppercase tracking-[0.3em] text-black/50 mb-2"
          >
            Contraparte
          </p>
          <p
            class="text-xl font-black text-black wrap-break-word"
            id="modal-counterparty"
          >
            No disponible
          </p>
          <p
            class="text-xs font-bold uppercase tracking-widest text-black/60 mt-1"
          >
            Usuario relacionado con esta operación
          </p>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <button
        id="download-receipt-btn"
        class="w-full bg-black text-white hover:bg-[#8b5cf6] border-[3px] border-black py-4 font-black uppercase tracking-widest text-sm flex items-center justify-center gap-2 transition-colors group shadow-[4px_4px_0px_0px_rgba(139,92,246,1)] hover:-translate-y-1 hover:shadow-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 group-hover:animate-bounce"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        Descargar Comprobante
      </button>
    </div>
  </div>
</div>
