---
import { Card } from "../../ui";
---

<Card
  id="perfil-card"
  class="p-6! relative overflow-hidden group shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] border-4 border-black  transition-all duration-500"
>
  <div
    id="glow-nivel"
    class="absolute -top-24 -right-24 w-48 h-48  blur-3xl pointer-events-none"
    style="background: rgba(96, 165, 250, 0.2)"
  >
  </div>
  <div
    class="absolute -bottom-16 -left-16 w-40 h-40 bg-brand-purple/10  blur-2xl pointer-events-none"
  >
  </div>

  <div class="relative z-10">
    <div class="flex flex-col items-center text-center gap-4 sm:gap-5 xl:gap-6 2xl:gap-7 mb-5 xl:mb-6">
      <div class="relative shrink-0">
        <div
          id="profile-photo-border"
          class="w-24 h-24 sm:w-28 sm:h-28 xl:w-32 xl:h-32 2xl:w-36 2xl:h-36 p-1 bg-linear-to-br from-brand-lime to-brand-purple shadow-[0_0_30px_rgba(215,253,73,0.3)] transition-all duration-500"
        >
          <div
            id="profile-avatar"
            class="w-full h-full bg-[#fffdf6] border-2 border-black flex items-center justify-center"
            aria-label="Icono de usuario"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 xl:w-14 xl:h-14 2xl:w-16 2xl:h-16 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21a8 8 0 0 0-16 0"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
        </div>
      </div>

      <div class="w-full max-w-xl 2xl:max-w-2xl">
        <h2 id="nombre-usuario" class="text-2xl sm:text-3xl xl:text-4xl 2xl:text-[2.7rem] font-black text-black leading-none tracking-tight mb-1 xl:mb-1.5">
          Usuario
        </h2>
        <p id="descripcion-usuario" class="text-[#334155] font-bold text-xs sm:text-sm xl:text-base 2xl:text-lg mb-3 xl:mb-4 uppercase tracking-wide xl:tracking-wider">
          Estudiante de Ingeniería en Sistemas
        </p>

        <div class="flex flex-col items-center gap-2 xl:gap-2.5">
          <div
            id="nivel-badge"
            class="px-4 xl:px-5 2xl:px-6 py-1.5 xl:py-2 text-sm xl:text-base 2xl:text-lg font-black uppercase shadow-[0_0_15px_rgba(96,165,250,0.3)] transition-all duration-300"
            style="background: rgba(96, 165, 250, 0.1); border: 2px solid #60A5FA; color: #60A5FA"
          >
            <span id="nivel-text">Bachiller</span>
          </div>
          <span class="text-xs xl:text-sm 2xl:text-base text-black font-black uppercase tracking-wide">
            XP <span id="xp-actual">1,500</span> / <span id="xp-siguiente">2,000</span>
          </span>
        </div>
      </div>
    </div>

    <div class="pt-5 xl:pt-6 border-t border-black">
      <div class="flex items-center justify-between gap-2 mb-3 xl:mb-4">
        <div class="flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 xl:h-5 xl:w-5 text-yellow-400"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
            ></path></svg
          >
          <h3 class="text-sm xl:text-base 2xl:text-lg font-bold text-black uppercase tracking-wider">
            Mis Insignias
          </h3>
        </div>
        <span id="badges-unlocked-count" class="px-2 xl:px-2.5 py-0.5 xl:py-1 border-2 border-black bg-white text-[10px] xl:text-[11px] font-black uppercase">0/0</span>
      </div>

      <div id="badges-list" class="flex items-start gap-2.5 xl:gap-3 2xl:gap-4 overflow-x-auto pt-1 pb-2 no-scrollbar">
        <p class="text-[11px] font-bold uppercase text-slate-700">Cargando insignias...</p>
      </div>
      <p id="badges-hint" class="mt-2 text-[10px] xl:text-[11px] font-black uppercase text-slate-700">Completa misiones y rachas para desbloquear insignias.</p>

      <div class="mt-3 xl:mt-4 border-2 border-black bg-white px-3 xl:px-4 py-2 xl:py-2.5">
        <p class="text-[10px] xl:text-[11px] font-black uppercase tracking-wider text-slate-700 mb-1.5">Insignias recientes</p>
        <div id="badges-recent-list" class="space-y-1.5">
          <p class="text-[10px] font-bold uppercase text-slate-500">Aun no hay insignias recientes.</p>
        </div>
      </div>

      <div class="hidden" aria-hidden="true">
        <span id="badge-icon-template-utensils"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7a2 2 0 0 0 2 2h1"></path><path d="M7 2v20"></path><path d="M21 15V2a5 5 0 0 0-5 5v8"></path><path d="M21 15a5 5 0 0 1-5 5h-1"></path></svg></span>
        <span id="badge-icon-template-flame"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s4 4 4 8a4 4 0 0 1-8 0c0-2.4 1.2-4.3 4-8z"></path><path d="M8.5 14a3.5 3.5 0 1 0 7 0c0-1.5-.8-2.8-3.5-5-2.7 2.2-3.5 3.5-3.5 5z"></path></svg></span>
        <span id="badge-icon-template-calendar"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg></span>
        <span id="badge-icon-template-shield"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z"></path><path d="m9 12 2 2 4-4"></path></svg></span>
        <span id="badge-icon-template-level-1"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"></path><path d="M7 10a5 5 0 0 1 10 0"></path><path d="M6 22h12"></path></svg></span>
        <span id="badge-icon-template-level-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18"></path><path d="M8 10v4a4 4 0 0 0 8 0v-4"></path><path d="M12 14v6"></path><path d="M9 20h6"></path></svg></span>
        <span id="badge-icon-template-level-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h12"></path><path d="M18 2v20"></path><path d="M6 7h10"></path><path d="M6 12h10"></path><path d="M6 17h10"></path></svg></span>
        <span id="badge-icon-template-level-4"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"></path><path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z"></path></svg></span>
        <span id="badge-icon-template-level-5"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h3l2 8h8l2-8h3"></path><path d="M6 7 8 3l4 4 4-4 2 4"></path><path d="M9 19h6"></path></svg></span>
        <span id="badge-icon-template-level-6"><svg xmlns="http://www.w3.org/2000/svg" class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 16.9 6.4 19.2l1.1-6.2L3 8.6l6.2-.9L12 2z"></path></svg></span>
      </div>
    </div>
  </div>
</Card>
