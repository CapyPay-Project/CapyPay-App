---
import MainLayout from "../../layouts/MainLayout.astro";
import CartSidebar from "../../components/widgets/CartSidebar.astro";
import { showToast } from "../../utils/toast";
import CantinaHeader from "../../components/widgets/cantina/CantinaHeader.astro";
import AreasView from "../../components/widgets/cantina/AreasView.astro";
import CantinasView from "../../components/widgets/cantina/CantinasView.astro";
import ProductsView from "../../components/widgets/cantina/ProductsView.astro";
import FloatingActions from "../../components/widgets/comedor/FloatingActions.astro";
---

<MainLayout title="Cantina | CapyPay" showSidebar={true}>
  <CartSidebar />


  <style>
    @media (max-width: 768px) {
      :global(#cart-sidebar) {
        padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
      }
      :global(#checkout-btn) {
        margin-bottom: calc(4.5rem + env(safe-area-inset-bottom));
      }
    }
  </style>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 pb-40 min-h-screen flex flex-col">
    <!-- Header -->
    <CantinaHeader />

    <!-- VISTA 1: LISTADO DE ÁREAS (Nivel 1) -->
    <AreasView />

    <!-- VISTA 2: LISTADO DE CANTINAS DEL ÁREA (Nivel 2) -->
    <CantinasView />

    <!-- VISTA 3: PRODUCTOS DE LA CANTINA (Nivel 3) -->
    <ProductsView />
  </div>

  <FloatingActions hideOrders={true} />

  <style>
    /* Ocultar scrollbar horizontal en todas las vistas */
    #areas-view,
    #cantinas-view,
    #products-view,
    #areas-list,
    #cantinas-list,
    #products-grid {
      overflow-x: hidden;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    #areas-view::-webkit-scrollbar,
    #cantinas-view::-webkit-scrollbar,
    #products-view::-webkit-scrollbar,
    #areas-list::-webkit-scrollbar,
    #cantinas-list::-webkit-scrollbar,
    #products-grid::-webkit-scrollbar {
      display: none;
    }

    /* Asegurar que el contenido no desborde */
    .overflow-hidden-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  </style>

  <script>
    // @ts-nocheck
    import { cantinaService } from "../../services/api";
    import { showToast } from "../../utils/toast";

    // ==========================================
    // DYNAMIC DATA FROM BACKEND
    // ==========================================
    let cantinasData = [];
    let areasData = [];

    // ==========================================
    // ESTADO DE LA APLICACIÓN
    // ==========================================
    let currentArea = null;
    let currentCantina = null;

    // ==========================================
    // ELEMENTOS DEL DOM (se inicializan dinámicamente)
    // ==========================================
    let areasView, cantinasView, productsView, areasList, cantinasList, productsGrid, backToAreasBtn, backToCantinasBtn;

    function initDOMElements() {
      areasView = document.getElementById("areas-view");
      cantinasView = document.getElementById("cantinas-view");
      productsView = document.getElementById("products-view");
      areasList = document.getElementById("areas-list");
      cantinasList = document.getElementById("cantinas-list");
      productsGrid = document.getElementById("products-grid");
      backToAreasBtn = document.getElementById("back-to-areas");
      backToCantinasBtn = document.getElementById("back-to-cantinas");
      
      if(backToAreasBtn) backToAreasBtn.addEventListener("click", showAreasView);
      if(backToCantinasBtn) backToCantinasBtn.addEventListener("click", showCantinasView);
    }

    // ==========================================
    // FUNCIONES DE RENDERIZADO
    // ==========================================

    function renderCantinaDelDia() {
      // Seleccionar una cantina aleatoria de las que están abiertas
      const openCantinas = cantinasData.filter((c) => c.isOpen);
      const card = document.getElementById("cantina-del-dia");

      if (!card || openCantinas.length === 0) {
        if (card) {
          card.classList.add("opacity-60", "cursor-not-allowed");
          card.onclick = null;
        }
        const nameEl = document.getElementById("cantina-del-dia-name");
        const facultyEl = document.getElementById("cantina-del-dia-faculty");
        const votesEl = document.getElementById("cantina-del-dia-votes");
        const imgEl = document.getElementById("cantina-del-dia-img");
        if (nameEl) nameEl.textContent = "Sin cantinas abiertas";
        if (facultyEl) facultyEl.textContent = "Vuelve mas tarde";
        if (votesEl) votesEl.textContent = "0";
        if (imgEl) imgEl.src = "https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=400";
        return;
      }
      const randomCantina = openCantinas[Math.floor(Math.random() * openCantinas.length)];

      // Obtener el nombre del área
      const area = areasData.find((a) => String(a.id) === String(randomCantina.faculty));

      // Actualizar UI
      document.getElementById("cantina-del-dia-img").src = randomCantina.image;
      document.getElementById("cantina-del-dia-name").textContent = randomCantina.name;
      document.getElementById("cantina-del-dia-faculty").textContent = area ? area.name : "";
      document.getElementById("cantina-del-dia-votes").textContent = Math.floor(Math.random() * 200) + 150;

      // Añadir click para ir a la cantina
      card.classList.remove("opacity-60", "cursor-not-allowed");
      card.onclick = () => {
        showCantinasList(area);
        setTimeout(() => {
          showProductsView(randomCantina);
        }, 100);
      };
    }

    function renderAreasList() {
      areasList.innerHTML = "";

      const fragment = document.createDocumentFragment();

      areasData.forEach((area) => {
        // Calcular estadísticas del área
        const areaCantinas = cantinasData.filter((c) => String(c.faculty) === String(area.id));
        const totalCantinas = areaCantinas.length;
        const activeCantinas = areaCantinas.filter((c) => c.isOpen).length;

        const card = document.createElement("div");
        card.className =
          "bg-white border-4 border-black overflow-hidden cursor-pointer transition-all hover:translate-y-1 hover:shadow-none duration-300 ease-out group min-w-0 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]";
        card.innerHTML = `
          <div class="relative h-44 overflow-hidden border-b-4 border-black bg-[#fff9f0]">
            <img
              src="${area.image}"
              alt="${area.name}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-2 right-2 bg-[#d7fd48] border-2 border-black px-2 py-1">
              <span class="text-black font-black text-[10px] uppercase">${activeCantinas}/${totalCantinas}</span>
            </div>
          </div>
          <div class="p-4">
            <h4 class="font-black text-base text-black mb-1 uppercase truncate">${area.name}</h4>
            <p class="text-black/60 text-[10px] font-black mb-3 uppercase line-clamp-2">${area.description}</p>
            <div class="flex items-center justify-between">
              <span class="text-[10px] text-black font-black uppercase flex items-center gap-1.5 truncate">
                <div class="w-2 h-2 border border-black bg-[#22c55e] shrink-0"></div>
                ${activeCantinas} abiertas
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 text-black group-hover:translate-x-1 transition-transform shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                ></path>
              </svg>
            </div>
          </div>
        `;
        card.addEventListener("click", () => showCantinasList(area));
        fragment.appendChild(card);
      });

      areasList.appendChild(fragment);
    }

    function renderCantinasList(area) {
      const areaCantinas = cantinasData.filter((c) => String(c.faculty) === String(area.id));
      const activeCantinas = areaCantinas.filter((c) => c.isOpen).length;

      // Actualizar encabezado
      document.getElementById("area-title").textContent = area.name;
      document.getElementById("area-stats").innerHTML = `<span class="w-2 h-2 border border-black bg-[#d7fd48] shrink-0"></span> ${activeCantinas} de ${areaCantinas.length} cantinas activas`;

      // Limpiar contenedor de manera suave
      cantinasList.style.opacity = '0';
      cantinasList.innerHTML = "";

      // Renderizar cards
      const fragment = document.createDocumentFragment();

      areaCantinas.forEach((cantina, index) => {
           const statusBadge = cantina.isOpen
          ? `<span class="absolute top-2 left-2 inline-flex items-center gap-1 px-2 py-1 border-2 border-black bg-[#d7fd48] text-black text-[10px] font-black uppercase tracking-wide">
            <span class="w-2 h-2 border border-black bg-[#22c55e]"></span>
               Abierto
             </span>`
          : `<span class="absolute top-2 left-2 inline-flex items-center gap-1 px-2 py-1 border-2 border-black bg-[#fecaca] text-black text-[10px] font-black uppercase tracking-wide">
            <span class="w-2 h-2 border border-black bg-[#ef4444]"></span>
               Cerrado
             </span>`;

        const card = document.createElement("div");
        card.className =
          "bg-white border-4 border-black p-4 group transition-all hover:translate-y-1 hover:shadow-none duration-300 ease-out cursor-pointer min-w-0 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]";
        card.style.opacity = '0';
        card.style.transform = 'translateY(10px)';
        card.innerHTML = `
          <div class="relative h-44 overflow-hidden mb-3 border-2 border-black bg-[#fff9f0]">
            <img
              src="${cantina.image}"
              alt="${cantina.name}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            ${statusBadge}
          </div>
          <h4 class="font-black text-base text-black mb-1 uppercase truncate">${cantina.name}</h4>
          <p class="text-black/60 text-[10px] font-black mb-3 uppercase line-clamp-2">${cantina.description}</p>
          <div class="flex items-center justify-between">
            <span class="text-[10px] text-black font-black uppercase flex items-center gap-1.5 truncate">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4"></path><circle cx="9" cy="19" r="1"></circle><circle cx="17" cy="19" r="1"></circle></svg>
              ${cantina.products.length} productos
            </span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-black group-hover:translate-x-1 transition-transform shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              ></path>
            </svg>
          </div>
        `;
        card.addEventListener("click", () => showProductsView(cantina));
        fragment.appendChild(card);
      });

      cantinasList.appendChild(fragment);

      // Animar entrada de las cards
      requestAnimationFrame(() => {
        const cards = cantinasList.querySelectorAll('div');
        cards.forEach((card, index) => {
          if (card.style.opacity === '0') {
            setTimeout(() => {
              card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, index * 50);
          }
        });

        // Mostrar el contenedor
        cantinasList.style.transition = 'opacity 0.2s ease';
        cantinasList.style.opacity = '1';
      });
    }

    function renderProducts(cantina) {
      productsGrid.innerHTML = "";

      cantina.products.forEach((product) => {
        const isOutOfStock = !product.isAvailable || product.stock <= 0;
        
        const card = document.createElement("div");
        card.className = `bg-white border-4 border-black p-3 sm:p-4 group transition-all ${isOutOfStock ? 'opacity-75 grayscale-[0.35]' : 'hover:translate-y-1 hover:shadow-none'} duration-300 ease-out min-w-0 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]`;
        
        const stockOverlay = isOutOfStock ? `
          <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px] z-10 flex flex-col items-center justify-center">
            <span class="text-red-500 font-black text-[10px] sm:text-xs border-2 border-red-500 px-3 py-1 -full uppercase tracking-widest bg-red-500/10 shadow-[0_0_15px_rgba(239,68,68,0.3)] transform -rotate-12">
              Sin Stock
            </span>
          </div>
        ` : '';
        
        const buttonClasses = isOutOfStock 
          ? 'w-full py-2.5 border-2 border-black text-black/40 font-black text-[10px] uppercase bg-[#f3f4f6] cursor-not-allowed'
          : 'buy-btn w-full py-2.5 border-2 border-black text-black font-black text-[10px] uppercase bg-[#d7fd48] hover:translate-y-1 hover:shadow-none transition-all cursor-pointer shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]';

        card.innerHTML = `
          <div class="relative h-40 sm:h-44 overflow-hidden mb-3 border-2 border-black bg-[#fff9f0] ${isOutOfStock ? 'scale-[0.98]' : ''}">
            ${stockOverlay}
            <img
              src="${product.image}"
              alt="${product.name}"
              class="w-full h-full object-cover ${isOutOfStock ? '' : 'group-hover:scale-105'} transition-transform duration-500"
            />
            <div class="absolute top-2 right-2 bg-[#d7fd48] px-2 py-0.5 border-2 border-black z-20">
              <span class="text-black font-black text-[10px] uppercase">+${product.xpReward} XP</span>
            </div>
          </div>
          <h4 class="font-black text-base text-black uppercase mb-1 truncate ${isOutOfStock ? 'text-black/50' : ''}">${product.name}</h4>
          <div class="flex items-center justify-between mb-3">
            <span class="text-black/70 text-[10px] font-black uppercase">Bs ${product.priceBs}</span>
            <span class="text-[#8b5cf6] font-black text-[10px] uppercase ${isOutOfStock ? 'opacity-50' : ''}">${product.priceCapys} BARAS</span>
          </div>
          <button
            class="${buttonClasses}"
            data-product-id="${product.id}"
            data-product-name="${product.name}"
            data-price="${product.priceCapys}"
            data-image="${product.image}"
            data-xp="${product.xpReward}"
            ${isOutOfStock ? 'disabled' : ''}
          >
            ${isOutOfStock ? 'AGOTADO' : 'AÑADIR AL CARRITO'}
          </button>
        `;
        productsGrid.appendChild(card);
      });

      // Añadir event listeners a los botones de compra
      document.querySelectorAll(".buy-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const pId = btn.dataset.productId;
          const pName = btn.dataset.productName;
          const pPrice = parseInt(btn.dataset.price || "0");
          const pImage = btn.dataset.image;
          handlePurchase({ id: pId, name: pName, price: pPrice, image: pImage });
        });
      });
    }

    // ==========================================
    // NAVEGACIÓN ENTRE VISTAS
    // ==========================================

    function showCantinasList(area) {
      // Scroll al inicio ANTES de cambiar la vista
      window.scrollTo({ top: 0, behavior: 'instant' });
      document.documentElement.scrollTop = 0;
      document.body.scrollTop = 0;

      currentArea = area;
      renderCantinasList(area);

      areasView.classList.add("hidden");
      cantinasView.classList.remove("hidden");
      productsView.classList.add("hidden");

      // Forzar scroll inmediato después de cambiar la vista
      requestAnimationFrame(() => {
        window.scrollTo({ top: 0, behavior: 'instant' });
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;

        // Scroll al encabezado de cantinas
        const header = document.getElementById("cantinas-header");
        if (header) {
          header.scrollIntoView({ behavior: 'instant', block: 'start' });
        }
      });

      // Scroll suave adicional después de que las cards terminen de animarse
      setTimeout(() => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 1000);
    }

    function showProductsView(cantina) {
      currentCantina = cantina;

      // Actualizar encabezado
      document.getElementById("cantina-image").src = cantina.image;
      document.getElementById("cantina-name").textContent = cantina.name;
      document.getElementById("cantina-description").textContent = cantina.description;

      // Badge de estado
      const statusBadge = document.getElementById("cantina-status");
      if (cantina.isOpen) {
        statusBadge.className =
          "px-2 sm:px-3 py-1 border-2 border-black text-[10px] sm:text-xs font-black uppercase tracking-wider bg-[#d7fd48] text-black";
        statusBadge.innerHTML = `<span class="inline-flex items-center gap-1 sm:gap-1.5"><span class="w-2 h-2 border border-black bg-[#22c55e]"></span>Abierto</span>`;
      } else {
        statusBadge.className =
          "px-2 sm:px-3 py-1 border-2 border-black text-[10px] sm:text-xs font-black uppercase tracking-wider bg-[#fecaca] text-black";
        statusBadge.innerHTML = `<span class="inline-flex items-center gap-1 sm:gap-1.5"><span class="w-2 h-2 border border-black bg-[#ef4444]"></span>Cerrado</span>`;
      }

      // Renderizar productos o mensaje de cerrado
      const productsGrid = document.getElementById("products-grid");
      const productsTitle = document.getElementById("products-title");

      if (cantina.isOpen) {
        productsTitle.classList.remove("hidden");
        renderProducts(cantina);
      } else {
        productsTitle.classList.add("hidden");
        productsGrid.innerHTML = `
          <div class="col-span-full flex flex-col items-center justify-center py-14 text-center bg-white border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-6">
            <div class="w-18 h-18 border-2 border-black bg-[#fecaca] flex items-center justify-center mb-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-9 w-9 text-[#b91c1c]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path>
              </svg>
            </div>
            <h4 class="text-2xl font-black uppercase text-black mb-3">Esta cantina esta cerrada</h4>
            <p class="text-black/70 text-sm font-bold uppercase max-w-md">
              Lo sentimos, pero por el momento esta cantina no está disponible para realizar compras.
              Por favor, intenta con otra cantina de la facultad.
            </p>
            <button
              onclick="showCantinasList(currentArea)"
              class="mt-7 px-5 py-3 border-4 border-black bg-[#d7fd48] hover:translate-y-1 hover:shadow-none text-black font-black text-xs uppercase tracking-wider transition-all shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              Volver a cantinas
            </button>
          </div>
        `;
      }

      areasView.classList.add("hidden");
      cantinasView.classList.add("hidden");
      productsView.classList.remove("hidden");

      // Scroll al inicio de la página
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showAreasView() {
      currentArea = null;
      currentCantina = null;

      areasView.classList.remove("hidden");
      cantinasView.classList.add("hidden");
      productsView.classList.add("hidden");

      // Scroll al inicio de la página
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showCantinasView() {
      currentCantina = null;

      areasView.classList.add("hidden");
      cantinasView.classList.remove("hidden");
      productsView.classList.add("hidden");

      // Scroll al inicio de la página
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ==========================================
    // MANEJO DE COMPRAS (CARRITO GLOBAL)
    // ==========================================

    import { addItemToCart, isCartOpen, cartItems } from "../../store/cartStore";

    function handlePurchase(baseItem) {
      const item = {
        ...baseItem,
        contextType: 'cantina',
        cantinaId: currentCantina?.id || null,
      };
      addItemToCart(item);
      
      isCartOpen.set(true);
      showToast("Carrito", `¡${item.name} agregado al carrito!`, "success");
    }

    function updateUserXP(xpToAdd) {
      const user = JSON.parse(localStorage.getItem("capypay_user") || "{}");
      if (user.xp !== undefined) {
        user.xp += xpToAdd;
        localStorage.setItem("capypay_user", JSON.stringify(user));
      }
    }



    // ==========================================
    // INICIALIZACIÓN Y SUSCRIPCIÓN AL CARRITO
    // ==========================================

    function getAreaImage(areaId, index = 0) {
      const seed = String(areaId ?? index ?? 0).toLowerCase().replace(/\s+/g, "-");
      return `https://picsum.photos/seed/capy-area-${seed}/900/600`;
    }

    async function loadCantinaData() {
      initDOMElements(); // Refresh DOM references

      try {
        const [areasRes, cantinasRes] = await Promise.all([
          cantinaService.getAreas(),
          cantinaService.getCantinas()
        ]);

        const rawAreas = Array.isArray(areasRes?.faculties)
          ? areasRes.faculties
          : Array.isArray(areasRes?.data)
            ? areasRes.data
            : Array.isArray(areasRes)
              ? areasRes
              : [];

        if (rawAreas.length > 0) {
          const colors = [
            "bg-blue-500/20 border-blue-500/30 text-blue-400",
            "bg-green-500/20 border-green-500/30 text-green-400",
            "bg-purple-500/20 border-purple-500/30 text-purple-400",
            "bg-orange-500/20 border-orange-500/30 text-orange-400",
            "bg-cyan-500/20 border-cyan-500/30 text-cyan-400",
            "bg-yellow-500/20 border-yellow-500/30 text-yellow-400"
          ];
          
          areasData = rawAreas.map((f, i) => ({
            id: f.id,
            name: f.name || f.nombre || `Facultad ${f.id ?? i + 1}`,
            image: f.image_url || f.image || getAreaImage(f.id, i),
            description: f.description || f.descripcion || "Area de facultad",
            color: colors[i % colors.length]
          }));
        }

        const rawCantinas = Array.isArray(cantinasRes?.cantinas)
          ? cantinasRes.cantinas
          : Array.isArray(cantinasRes?.data)
            ? cantinasRes.data
            : Array.isArray(cantinasRes)
              ? cantinasRes
              : [];

        if (rawCantinas.length > 0) {
          cantinasData = rawCantinas.map(c => ({
            id: c.id,
            name: c.name,
            faculty: c.faculty_id,
            isOpen: c.is_active,
            image: c.image_url || "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=600",
            description: c.location || "Cantina universitaria",
            products: (c.products || []).map(p => ({
              id: p.id,
              name: p.name,
              priceBs: p.price_bs,
              priceCapys: p.price_capys,
              image: p.image_url || "https://images.unsplash.com/photo-1565557623262-b51c2513a641?w=300",
              xpReward: Math.ceil(p.price_capys * 0.1) || 0,
              stock: p.stock,
              isAvailable: p.is_available
            }))
          }));
        }

        if (areasData.length === 0 && cantinasData.length > 0) {
          const inferred = new Map();
          cantinasData.forEach((c) => {
            const key = String(c.faculty ?? "sin-facultad");
            if (!inferred.has(key)) {
              inferred.set(key, {
                id: c.faculty ?? key,
                name: c.faculty_name || `Facultad ${key}`,
                image: getAreaImage(key, inferred.size),
                description: "Area inferida por cantinas",
                color: "bg-blue-500/20 border-blue-500/30 text-blue-400"
              });
            }
          });
          areasData = Array.from(inferred.values());
        }
        
        if(areasData.length > 0) {
           renderAreasList();
           if (cantinasData.length > 0) {
              renderCantinaDelDia();
           } else {
             // Si hay facultades pero no cantinas, aun asi renderizamos facultades.
             renderCantinaDelDia();
           }
        } else {
            areasView.innerHTML = "<div class='text-center py-20 text-black/70 font-black uppercase border-4 border-black bg-white shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-6'>No hay cantinas registradas en la base de datos</div>";
        }

      } catch (error) {
        console.error("Error cargando cantinas:", error);
        showToast("Error", "No se pudieron cargar las cantinas ni las áreas.", "error");
      }
    }
    
    // Cart Badge Sync (Tomado de Comedor.astro)
    const cartBadge = document.getElementById("cart-badge-count");
    
    cartItems.subscribe((items) => {
      const count = Object.values(items)
        .filter((i: any) => i.contextType === 'cantina')
        .reduce((acc, item: any) => acc + item.quantity, 0);
      if (cartBadge) {
        cartBadge.textContent = count.toString();
        if (count > 0) {
          cartBadge.style.display = "flex";
          cartBadge.classList.remove("hidden");
        } else {
          cartBadge.style.display = "none";
          cartBadge.classList.add("hidden");
        }
      }
      const mBtn = document.getElementById("manual-cart-btn");
      if (count > 0 && mBtn) {
        mBtn.classList.add("scale-110");
        setTimeout(() => mBtn.classList.remove("scale-110"), 200);
      }
    });

    let hasInitializedCantinaPage = false;
    function initCantinaPageOnce() {
      if (hasInitializedCantinaPage) return;
      hasInitializedCantinaPage = true;

      const mBtn = document.getElementById("manual-cart-btn");
      if (mBtn) mBtn.addEventListener("click", () => isCartOpen.set(true));

      loadCantinaData();
    }

    // Initialize Page Logic
    document.addEventListener("astro:page-load", () => {
      initCantinaPageOnce();
    });
    
    // Fallback for non-ViewTransitions if used (or initial load)
    if (
      document.readyState === "complete" ||
      document.readyState === "interactive"
    ) {
      initCantinaPageOnce();
    }
  </script>
</MainLayout>
