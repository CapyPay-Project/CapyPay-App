---
import MainLayout from "../../layouts/MainLayout.astro";

interface Parada {
  nombre: string;
  estado: string;
  porcentaje: number;
}

const precioPasaje = 5.00;

const paradasUNERG: Parada[] = [
  { nombre: "Terminal", estado: "Lleno", porcentaje: 90 },
  { nombre: "La Redoma", estado: "Normal", porcentaje: 40 },
  { nombre: "Plaza Bolívar", estado: "Vacio", porcentaje: 15 },
  { nombre: "UNERG Entrada", estado: "Normal", porcentaje: 55 },
  { nombre: "Área de Salud", estado: "Lleno", porcentaje: 85 },
  { nombre: "Ingeniería", estado: "Vacio", porcentaje: 20 },
];
---

<MainLayout title="TicketBus | Tu Asistente de Transporte" showSidebar={true}>
  <div class="flex flex-col gap-6 h-full p-2 sm:p-4 lg:p-0">
    <!-- Tarjeta principal "TicketBus" -->
  <div class="bg-[#d7fd48] p-5 sm:p-6 border-4 border-black box-shadow-brutal relative overflow-hidden">
      <div class="relative z-10 flex gap-4 items-center w-full justify-between">
          <div class="flex items-center gap-4">
          <div class="w-14 h-14 border-2 border-black bg-white flex items-center justify-center text-black">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="8" width="18" height="10" rx="2" ry="2"/>
              <path d="M3 13h18"/>
              <circle cx="7" cy="17" r="1.2"/>
              <circle cx="17" cy="17" r="1.2"/>
              <rect x="7" y="10" width="10" height="4" rx="0.5" ry="0.5"/>
             <path d="M3 11 L1 11 L1 13"/>
             <path d="M21 11 L23 11 L23 13"/>
            </svg>
          </div>
          <div>
            <h1 class="text-3xl font-black text-black tracking-tighter uppercase">TicketBus</h1>
            <p class="text-black/70 text-xs font-black tracking-widest uppercase">UNERG • Sistema de Transporte</p>
          </div>
        </div>
        <div class="text-right hidden sm:block">
          <p class="text-black/70 text-[10px] uppercase font-black tracking-[0.2em]">Costo Fijo</p>
          <p class="text-2xl font-black text-black">5.00 <span class="text-xs">BARAS</span></p>
        </div>
      </div>
      <div class="absolute -right-10 -top-10 w-28 h-28 border-4 border-black rounded-full bg-[#8b5cf6]/15"></div>
    </div>

    <!-- Saldo dinámico -->
    <div class="bg-white p-5 sm:p-6 border-4 border-black box-shadow-brutal relative overflow-hidden">
      <div class="flex flex-col relative z-10">
        <span class="text-black/70 text-xs uppercase mb-1 font-black tracking-wider">Tu saldo actual</span>
        <div class="flex items-baseline gap-2">
          <span id="ticketbus-balance" class="text-5xl sm:text-6xl font-black text-black font-monaco tracking-tighter">0.00</span>
          <span class="text-black/60 text-lg sm:text-xl font-black">BARAS</span>
        </div>
      </div>
      <div class="absolute -right-8 -bottom-10 w-24 h-24 border-4 border-black rounded-full bg-[#d7fd48]"></div>
    </div>

<!-- ==================== WIZARD DE 3 PASOS ==================== -->
    <div class="bg-white border-4 border-black box-shadow-brutal p-5 sm:p-6 min-h-85 flex flex-col">

      <!-- Paso 1: Seleccionar Parada -->
      <div id="step-1" class="step-container">
        <div class="text-center mb-6">
          <span class="bg-black text-white text-[10px] font-black px-3 py-1 uppercase tracking-widest border-2 border-black">Paso 1 de 3</span>
          <h2 class="text-black text-2xl font-black mt-2 tracking-tight uppercase">¿A dónde vas?</h2>
          <p class="text-black/60 text-xs mt-1 font-bold uppercase">Selecciona tu parada de destino</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-64 overflow-y-auto pr-2 custom-scrollbar">
        {paradasUNERG.map((parada) => (
          <button onclick={`window.seleccionarParada('${parada.nombre}')`}
                  class="opcion-parada group w-full p-4 border-2 border-black bg-white hover:bg-[#f6f6f6] transition-all text-left">
                <span class="text-black font-black block transition-colors uppercase">{parada.nombre}</span>
            
            <span class={`inline-flex items-center gap-1.5 text-[10px] uppercase font-black px-2.5 py-1 border-2 border-black mt-2
              ${parada.estado === 'Lleno' ? 'bg-[#fecaca] text-black' : 
                parada.estado === 'Normal' ? 'bg-[#fde68a] text-black' : 
                'bg-[#bbf7d0] text-black'}`}>
              <span class={`w-2 h-2 border border-black
                ${parada.estado === 'Lleno' ? 'bg-[#ef4444]' : 
                  parada.estado === 'Normal' ? 'bg-[#f59e0b]' : 
                  'bg-[#22c55e]'}`}></span>
              {parada.estado}
            </span>
          </button>
          ))}
        </div>
      </div>

      <!-- Paso 2: Seleccionar Autobús -->
      <div id="step-2" class="step-container hidden">
        <div class="flex items-center gap-4 mb-6">
          <button onclick="window.goToStep(1)" class="p-2 hover:bg-black hover:text-white border-2 border-black text-black transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <div>
            <span class="bg-[#d7fd48] text-black text-[10px] font-black px-3 py-1 uppercase tracking-widest border-2 border-black">Paso 2 de 3</span>
            <h2 class="text-black text-xl font-black mt-1 uppercase">Unidades Disponibles</h2>
          </div>
        </div>
        <div id="menu-buses-disponibles" class="grid grid-cols-1 gap-3"></div>
      </div>

      <!-- Paso 3: Confirmar y Pagar -->
      <div id="step-3" class="step-container hidden">
        <div class="flex items-center gap-4 mb-6">
          <button onclick="window.goToStep(2)" class="p-2 hover:bg-black hover:text-white border-2 border-black text-black transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <div>
            <span class="bg-[#8b5cf6] text-white text-[10px] font-black px-3 py-1 uppercase tracking-widest border-2 border-black">Paso 3 de 3</span>
            <h2 class="text-black text-xl font-black mt-1 uppercase">Confirmar Ticket</h2>
          </div>
        </div>
        <div class="bg-[#fff9f0] p-6 border-2 border-black mb-6 text-center">
          <p class="text-black/60 text-[10px] uppercase font-black tracking-[0.2em] mb-2">Destino Seleccionado</p>
          <p id="resumen-destino" class="text-black text-3xl font-black italic mb-4">---</p>
          <p id="resumen-bus" class="text-[#8b5cf6] text-xl font-black"></p>
          <div class="flex justify-between items-center px-4 py-3 bg-white border-2 border-black mt-6">
            <span class="text-black/60 text-xs font-black uppercase">Costo del Pasaje</span>
            <span class="text-black font-black">5.00 BARAS</span>
          </div>
        </div>
        <div class="relative group">
          <button id="btn-pagar" class="relative w-full py-5 border-4 border-black font-black text-xl bg-[#d7fd48] text-black flex items-center justify-center gap-3 active:translate-y-1 transition-all box-shadow-brutal uppercase">
            GENERAR TICKET QR
          </button>
        </div>
      </div>
    </div>

    <!-- Novedades + Estado de Paradas (Glassmorphism mejorado) -->
    <div class="grid grid-cols-1 lg:grid-cols-1 gap-6">
      <!-- Widget Novedades -->
      <div class="bg-white p-6 border-4 border-black box-shadow-brutal">
        <h3 class="text-black text-xl font-black mb-4 flex items-center gap-2 uppercase tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#8b5cf6]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Novedades de Ruta
        </h3>
        <div class="space-y-3 text-sm">
          <p class="text-black flex items-start gap-2 font-black uppercase tracking-wide">
            <span class="inline-flex items-center justify-center w-6 h-6 border-2 border-black bg-[#fde68a] text-[#92400e] shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m10.29 3.86-8.43 14.3A1 1 0 0 0 2.71 20h18.58a1 1 0 0 0 .85-1.54l-8.43-14.3a1 1 0 0 0-1.72 0Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </span>
            Retrasos en La Redoma (aprox. 15 min)
          </p>
          <p class="text-black flex items-start gap-2 font-black uppercase tracking-wide">
            <span class="inline-flex items-center justify-center w-6 h-6 border-2 border-black bg-[#bbf7d0] text-[#166534] shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
            </span>
            Unidad 024 salio de Ingenieria hace 5 min
          </p>
        </div>
      </div>

     <!-- NUEVA SECCIÓN: AUTOBUSES EN RUTA + MAPA -->
      <div class="bg-white p-6 border-4 border-black box-shadow-brutal">
        <h3 class="text-black text-xl font-black mb-5 flex items-center gap-2 uppercase tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-lime" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V10a2 2 0 012-2h2m-2 0V8a2 2 0 012-2" />
          </svg>
        Autobuses en Ruta
      </h3>

      <!-- Tarjetas de autobuses -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8" id="lista-autobuses">
        <!-- Se llenará con JavaScript -->
      </div>

      <!-- Mapa -->
      <div class="overflow-hidden border-4 border-black">
        <div id="mapa-unerg" class="h-80 w-full"></div>
        </div>
      </div>

      <!-- Widget Estado de Paradas -->
      <div class="ticketbus-stops-widget bg-white p-6 border-4 border-black box-shadow-brutal">
        <h3 class="ticketbus-stops-title text-black text-xl font-black mb-4 uppercase">Estado de Paradas</h3>
        <div class="ticketbus-stops-grid grid grid-cols-2 gap-4">
          {paradasUNERG.map(parada => (
            <div class="ticketbus-stop-item space-y-2">
              <p class="ticketbus-stop-name text-black text-sm font-black uppercase">{parada.nombre}</p>
              <div class="ticketbus-stop-bar w-full h-2 bg-black/10 overflow-hidden border border-black">
                <div class={`h-full transition-all duration-700 ${parada.porcentaje > 80 ? 'bg-red-500' : parada.porcentaje > 40 ? 'bg-yellow-500' : 'bg-green-500'}`}
                     style={`width: ${parada.porcentaje}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Trigger del Drawer de Tickets -->
    <div class="bg-white p-6 border-4 border-black box-shadow-brutal">
      <button id="btn-abrir-drawer" 
              class="w-full flex justify-between items-center text-black font-black text-xl transition-colors uppercase">
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 5l-7 7-7-7" />
          </svg>
          Mis Tickets Comprados
        </span>
        <span id="contador-tickets" class="bg-[#d7fd48] border-2 border-black px-2 py-0.5 text-black text-sm font-black">0</span>
      </button>
    </div>
  </div>

  <!-- DRAWER DE TICKETS -->
  <div id="drawer-tickets" class="hidden fixed inset-x-0 bottom-0 z-50 bg-white border-4 border-black rounded-t-3xl box-shadow-brutal max-h-[75vh] overflow-hidden translate-y-full transition-transform duration-300">
    <div class="p-6">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-black text-2xl font-black uppercase">Mis Tickets</h3>
        <button id="btn-cerrar-drawer" class="text-black hover:bg-black hover:text-white border-2 border-black px-2">✕</button>
      </div>
      <div id="lista-tickets-drawer" class="space-y-4 max-h-[55vh] overflow-y-auto pb-8"></div>
    </div>
  </div>

  <!-- MODAL QR -->
  <div id="modal-qr" class="hidden fixed inset-0 z-100 items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
    <div class="bg-white border-4 border-black p-8 max-w-sm w-full text-center flex flex-col items-center box-shadow-brutal">
      <h2 class="text-black text-3xl font-black mb-2 tracking-tighter uppercase">¡Viaje Listo!</h2>
      <p class="text-black/70 text-sm mb-8 font-bold uppercase">Muestra este codigo al chofer</p>
      
      <div class="bg-white p-2 border-2 border-black mb-8">
        <div id="qrcode" class="w-48 h-48 mx-auto"></div>
      </div>

      <div class="bg-[#fff9f0] border-2 border-black py-3 px-6 mb-8 w-full">
        <p id="info-ticket-destino" class="text-black font-monaco text-2xl font-black uppercase tracking-widest"></p>
        <p id="info-ticket-fecha" class="text-black/60 text-sm mt-2 font-bold"></p>
      </div>

      <button id="btn-cerrar-qr" 
              class="w-full py-4 bg-white hover:bg-black hover:text-white border-4 border-black font-black text-lg transition-colors uppercase">
        Cerrar Ticket
      </button>
    </div>
  </div>

  <!-- TOAST -->
  <div id="toast" class="hidden fixed bottom-8 left-1/2 -translate-x-1/2 px-6 py-3 rounded-2xl shadow-2xl text-white font-medium text-sm z-200"></div>
</MainLayout>

<link
  rel="stylesheet"
  href="/vendor/leaflet/leaflet.css"
/>

<script
  src="/vendor/leaflet/leaflet.js"
  is:inline
></script>




<script>
 // === FIXES TYPE SCRIPT ===
  const precioPasaje = 5.00;

  declare global {
    interface Window {
     mostrarTicketQr: (index: number) => void;
     goToStep: (step: number) => void;
     seleccionarParada: (parada: string) => void;
     seleccionarUnidad: (id: string) => void; 
     L?: any;
    }
  }
  // =========================

  import { authService, missionService, gamificationService, userService } from "../../services/api.js";

  let selectedDestino = "";
  let selectedBus = "";        
  let isProcessing = false;
  let saldoActual = 0;
  let ticketsCache: any[] = [];

  let mapaInstancia: any = null;

  function reproducirSonidoExito() {
    try {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;
      const ctx = new AudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(740, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(990, ctx.currentTime + 0.12);
      gain.gain.setValueAtTime(0.001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.08, ctx.currentTime + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.16);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.18);
      osc.onended = () => void ctx.close();
    } catch (_) {
      // Ignorar para no romper UX en navegadores con restricciones de audio.
    }
  }

  function triggerHaptic() {
    if (navigator.vibrate) navigator.vibrate([60, 30, 60]);
  }

  function showToast(message: string, type: 'success' | 'error' = 'success') {
    const toast = document.getElementById('toast') as HTMLElement;
    toast.textContent = message;
    toast.className = `fixed bottom-8 left-1/2 -translate-x-1/2 px-6 py-3 rounded-2xl shadow-2xl text-white font-medium text-sm z-200 transition-all ${
      type === 'success' ? 'bg-brand-lime text-black' : 'bg-red-500'
    }`;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 2800);
  }

  function persistirSaldoLocal(nuevoSaldo: number) {
    try {
      const localUser = JSON.parse(localStorage.getItem('capypay_user') || '{}');
      localUser.balance = Number(nuevoSaldo || 0);
      localStorage.setItem('capypay_user', JSON.stringify(localUser));

      const legacyProfile = JSON.parse(localStorage.getItem('capyPayUserProfile') || '{}');
      legacyProfile.balance = Number(nuevoSaldo || 0);
      legacyProfile.isLoading = false;
      localStorage.setItem('capyPayUserProfile', JSON.stringify(legacyProfile));
    } catch (_) {
      // no-op
    }
  }

  function renderBalance(value: number) {
    const balanceEl = document.getElementById("ticketbus-balance");
    if (!balanceEl) return;
    animateNumber(balanceEl, Number(balanceEl.textContent || 0), Number(value || 0), 550);
  }

  async function initBalance() {
    try {
      const localUser = JSON.parse(localStorage.getItem('capypay_user') || '{}');
      saldoActual = Number(localUser?.balance || 0);
      renderBalance(saldoActual);

      const remote = await userService.getProfile();
      if (remote && Number.isFinite(Number(remote.balance))) {
        saldoActual = Number(remote.balance || 0);
        persistirSaldoLocal(saldoActual);
        renderBalance(saldoActual);
      }
    } catch (_) {
      renderBalance(saldoActual);
    }
  }

  function loadTicketsLocal() {
    try {
      const raw = localStorage.getItem('misTicketsCapyPay');
      ticketsCache = raw ? JSON.parse(raw) : [];
      if (!Array.isArray(ticketsCache)) ticketsCache = [];
    } catch (_) {
      ticketsCache = [];
    }
  }

  function saveTicketsLocal() {
    try {
      localStorage.setItem('misTicketsCapyPay', JSON.stringify(ticketsCache));
    } catch (_) {
      // no-op
    }
  }

  function addTicketLocal(ticket: any) {
    ticketsCache = [...ticketsCache, ticket];
    saveTicketsLocal();
    renderTicketsDrawer();
  }

  function procesarPago(monto: number): boolean {
    if (saldoActual >= monto) {
      saldoActual -= monto;
      persistirSaldoLocal(saldoActual);
      renderBalance(saldoActual);
      triggerHaptic();
      reproducirSonidoExito();
      return true;
    }
    showToast("¡Saldo insuficiente! 💸", "error");
    return false;
  }

// ==================== WIZARD (3 PASOS) ====================

  window.goToStep = (step: number) => {
    document.querySelectorAll('.step-container').forEach(el => el.classList.add('hidden'));
    const target = document.getElementById(`step-${step}`);
    if (target) target.classList.remove('hidden');
  };

  window.seleccionarParada = (parada: string) => {
    selectedDestino = parada;
    document.getElementById('resumen-destino')!.textContent = parada;
    window.goToStep(2);
    mostrarMenuBuses(parada);
  };

  function mostrarMenuBuses(parada: string = selectedDestino) {
    const container = document.getElementById('menu-buses-disponibles');
    if (!container) return;

    // Datos de ejemplo (puedes expandir más tarde)
    const buses = [
      { id: "Unidad 024", puestos: 30, ocupados: 12, estado: "En camino" },
      { id: "Unidad 019", puestos: 30, ocupados: 28, estado: "Lleno" },
      { id: "Unidad 031", puestos: 30, ocupados: 5, estado: "En parada" },
      { id: "Unidad 010", puestos: 30, ocupados: 18, estado: "En camino" }
    ];

    container.innerHTML = buses.map(bus => {
      const disponible = bus.puestos - bus.ocupados;
      const isFull = disponible <= 0;

      return `
        <button onclick="window.seleccionarUnidad('${bus.id}')" ${isFull ? 'disabled' : ''}
                class="flex justify-between items-center p-5 border-2 border-black transition-all w-full ${isFull ? 'bg-red-100 opacity-70' : 'bg-white hover:bg-[#f8f8f8] hover:translate-y-1 hover:shadow-none box-shadow-brutal'}">
          <div>
            <p class="font-black text-black uppercase">${bus.id}</p>
            <p class="text-xs text-black/60 font-bold uppercase">${bus.estado}</p>
          </div>
          <div class="text-right">
            <p class="text-sm font-black ${isFull ? 'text-red-600' : 'text-[#166534]'}">${disponible} puestos libres</p>
          </div>
        </button>
      `;
    }).join('');
  }

  window.seleccionarUnidad = (unidad: string) => {
    selectedBus = unidad;
    document.getElementById('resumen-bus')!.textContent = unidad;
    window.goToStep(3);
  };


  function renderAutobusesEnRuta() {
    const container = document.getElementById('lista-autobuses');
    if (!container) return;

    const busesEnRuta = [
      { id: 'Unidad 024', ruta: 'Ingenieria -> UNERG', estado: 'En ruta', eta: '4 min', ocupacion: 42 },
      { id: 'Unidad 019', ruta: 'Terminal -> Redoma', estado: 'Cargando', eta: '7 min', ocupacion: 88 },
      { id: 'Unidad 031', ruta: 'Salud -> Centro', estado: 'Disponible', eta: '2 min', ocupacion: 21 },
      { id: 'Unidad 010', ruta: 'UNERG -> Plaza Bolivar', estado: 'En ruta', eta: '6 min', ocupacion: 63 }
    ];

    container.innerHTML = busesEnRuta.map((bus) => {
      const tone = bus.estado === 'Cargando'
        ? 'text-black bg-[#fde68a] border-black'
        : bus.estado === 'En ruta'
          ? 'text-white bg-[#8b5cf6] border-black'
          : 'text-black bg-[#bbf7d0] border-black';

      const statusIcon = bus.estado === 'Cargando'
        ? '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.22-8.56"></path></svg>'
        : bus.estado === 'En ruta'
          ? '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>'
          : '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>';

      return `
      <article class="ticketbus-route-card border-2 border-black bg-white p-3.5 transition-all box-shadow-brutal hover:translate-y-1 hover:shadow-none">
        <div class="ticketbus-route-head flex items-start justify-between gap-3">
          <div>
            <p class="text-black font-black tracking-tight uppercase">${bus.id}</p>
            <p class="text-[11px] text-black/60 uppercase tracking-wide mt-1 font-bold">${bus.ruta}</p>
          </div>
          <span class="ticketbus-status-pill inline-flex items-center gap-1.5 text-[10px] font-black uppercase px-2 py-1 border-2 ${tone}">${statusIcon}${bus.estado}</span>
        </div>
        <div class="ticketbus-route-meta mt-2.5 flex items-center justify-between text-xs">
          <p class="text-black/70 font-bold">Llega en <span class="font-black text-black">${bus.eta}</span></p>
          <p class="text-black/70 font-bold">Ocupacion <span class="font-black text-black">${bus.ocupacion}%</span></p>
        </div>
      </article>`;
    }).join('');
  }

  // ==================== MAPA =================   
  async function initMapa() {
    const mapElement = document.getElementById('mapa-unerg');
    if (!mapElement) return;

    const Leaflet = window.L;
    if (!Leaflet) {
      showToast('Mapa no disponible temporalmente', 'error');
      return;
    }

    if (mapaInstancia) {
      mapaInstancia.remove();
      mapaInstancia = null;
    }

    mapaInstancia = Leaflet.map('mapa-unerg', { zoomControl: true, attributionControl: false }).setView([8.95, -67.45], 15);

    Leaflet.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19
    }).addTo(mapaInstancia);

    Leaflet.marker([8.95, -67.45]).addTo(mapaInstancia).bindPopup("UNERG Entrada");
    Leaflet.marker([8.94, -67.42]).addTo(mapaInstancia).bindPopup("Terminal");
  }

  async function vincularMisionTicketBus() {
    try {
      const user = authService.getCurrentUser();
      const userId = user?.id || user?.usuarioId || user?.user_id;
      if (!userId) return;

      await Promise.allSettled([
        missionService.completeMission('TICKET_BUS', userId),
        missionService.completeMission('REPEATABLE_BUS_TICKET', userId)
      ]);

      try {
        const weekly = await gamificationService.getWeeklyMissions(userId);
        const missions = Array.isArray(weekly?.missions) ? weekly.missions : [];
        const missionBus = missions.find((mission: any) => {
          const code = String(mission?.code || mission?.missionCode || mission?.slug || '').toLowerCase();
          const name = String(mission?.name || mission?.title || '').toLowerCase();
          const desc = String(mission?.description || mission?.desc || '').toLowerCase();
          return code.includes('ticket') || code.includes('bus') ||
            (name.includes('ticket') && name.includes('bus')) ||
            (desc.includes('ticket') && desc.includes('bus'));
        });

        const missionId = missionBus?.id || missionBus?.mission_id || missionBus?.missionId;
        if (missionId) {
          await gamificationService.progressMission(missionId, userId, 1);
        }
      } catch (_) {
        // Si weekly missions falla, el enlace legacy ya fue intentado arriba.
      }

      try {
        await gamificationService.getWeeklyMissions(userId);
      } catch (_) {
        // no-op
      }
    } catch (_) {
      // No bloqueamos compra de ticket si gamificacion falla.
    }
  }

  // ==================== TICKETS Y QR ====================
  function renderTicketsDrawer() {
    const container = document.getElementById('lista-tickets-drawer');
    if (!container) return;
    
    const tickets = ticketsCache;
    document.getElementById('contador-tickets')!.textContent = String(tickets.length);

    container.innerHTML = tickets.length === 0 
      ? `<p class="text-black/60 text-center py-8 font-black uppercase">Aun no tienes tickets</p>`
      : tickets.map((ticket: any, index: number) => `
        <button onclick="window.mostrarTicketQr(${index})" 
                class="ticket-card w-full bg-white hover:bg-[#f7f7f7] border-2 border-black p-5 text-left transition-all flex justify-between items-start box-shadow-brutal hover:translate-y-1 hover:shadow-none">
          <div>
            <p class="text-black/60 text-xs font-black uppercase">${ticket.fecha} • ${ticket.hora}</p>
            <p class="text-black text-xl font-black mt-1 uppercase">${ticket.destino}</p>
          </div>
          <div class="text-[#8b5cf6] text-sm font-black mt-1 uppercase">Ver QR -></div>
        </button>
      `).join('');
  }
  // ==================== TICKETS CON EXPIRACIÓN ====================
  function createTicket(destino: string, busUnidad: string) {
    const ahora = new Date();
    // PUNTO 1: Expiración en 2 horas
    const expira = new Date(ahora.getTime() + 2 * 60 * 60 * 1000); 

    return {
     id_unico: `Capy_${Date.now()}`,
      destino: destino,
      bus: busUnidad,
      fecha: ahora.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' }),
      hora: ahora.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }),
      // Guardamos la hora de expiración para mostrarla en el ticket
      expira: expira.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })
    };
  }

  window.mostrarTicketQr = (index: number) => {
    const ticket = ticketsCache[index];
    if (!ticket) return;

    const modal = document.getElementById('modal-qr')!;
    const qrContainer = document.getElementById('qrcode')!;
    const destinoEl = document.getElementById('info-ticket-destino')!;
    const fechaEl = document.getElementById('info-ticket-fecha')!;

    destinoEl.textContent = ticket.destino;
    fechaEl.textContent = `Comprado: ${ticket.fecha} • ${ticket.hora}`;

    const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=256x256&data=${encodeURIComponent(ticket.id_unico)}`;
    qrContainer.innerHTML = `<img src="${qrUrl}" alt="QR del ticket" class="w-48 h-48 object-cover border border-black" />`;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  };

  function animateNumber(element: HTMLElement, start: number, end: number, duration: number) {
    let startTime: number | null = null;
    const step = (timestamp: number) => {
      if (!startTime) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      const value = progress * (end - start) + start;
      element.textContent = value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }



  // ==================== INICIALIZACIÓN ====================

  document.addEventListener('DOMContentLoaded', () => {
    const btnPagar = document.getElementById('btn-pagar') as HTMLButtonElement;
    const btnAbrirDrawer = document.getElementById('btn-abrir-drawer');
    const btnCerrarDrawer = document.getElementById('btn-cerrar-drawer');
    const drawer = document.getElementById('drawer-tickets');
    const modalQr = document.getElementById('modal-qr');
    const btnCerrarQr = document.getElementById('btn-cerrar-qr');

    // Drawer
    btnAbrirDrawer?.addEventListener('click', () => {
      drawer?.classList.remove('hidden');
      setTimeout(() => drawer?.classList.remove('translate-y-full'), 10);
    });

    btnCerrarDrawer?.addEventListener('click', () => {
      drawer?.classList.add('translate-y-full');
      setTimeout(() => drawer?.classList.add('hidden'), 300);
    });

    // Btn pagar - Versión corregida para el wizard
    btnPagar?.addEventListener('click', () => {
      if (isProcessing || !selectedDestino || !selectedBus) {
        showToast("Selecciona un destino y un autobús primero", "error");
        return;
      }

      isProcessing = true;
      btnPagar.disabled = true;

      if (procesarPago(precioPasaje)) {
        const nuevoTicket = {
          id_unico: `CapyPay_TBus_${Date.now()}_${Math.random().toString(16).slice(2, 10)}`,
          destino: selectedDestino,
          bus: selectedBus,
          fecha: new Date().toLocaleDateString('es-ES', { day: '2-digit', month: 'short' }),
          hora: new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })
        };
        addTicketLocal(nuevoTicket);
        void vincularMisionTicketBus();
        showToast("¡Ticket generado exitosamente!", "success");
        window.mostrarTicketQr(ticketsCache.length - 1);

        // Reset del wizard
        selectedDestino = "";
        selectedBus = "";
        window.goToStep(1);
      }

      isProcessing = false;
      btnPagar.disabled = false;
    });

    // Cerrar QR
    btnCerrarQr?.addEventListener('click', () => {
      modalQr?.classList.add('hidden');
      modalQr?.classList.remove('flex');
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        modalQr?.classList.add('hidden');
        modalQr?.classList.remove('flex');
      }
    });

    // Inicializar nuevas secciones
    loadTicketsLocal();
    initBalance();
    renderAutobusesEnRuta();
    void initMapa();
    renderTicketsDrawer();
  });
</script>

