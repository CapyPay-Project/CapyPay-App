---
import LandingLayout from "../../layouts/LandingLayout.astro";
---

<LandingLayout title="Registro | CapyPay">
  <main class="min-h-[40vh] flex items-center justify-center p-6">
    <a
      href="/auth/login?mode=registro"
      class="border-2 border-black bg-[#d7fd48] px-4 py-2 font-black uppercase text-xs"
    >
      Continuar a registro
    </a>
  </main>

  <script>
    window.location.replace("/auth/login?mode=registro");
  </script>
</LandingLayout>
