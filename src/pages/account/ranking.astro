          <div
            class="relative z-10 grid grid-cols-1 lg:grid-cols-[1.2fr_1fr_0.9fr] gap-5"
          >
            <div class="border-2 border-white/50 bg-black/35 p-4 flex flex-col">
              <div class="flex items-start justify-between gap-3 mb-4">
                <div>
                  <p class="text-white/80 text-sm font-bold uppercase">
