      <div
        class="bg-[#0f172a] border-4 border-[#d7fd48] p-4 w-full max-w-6xl flex flex-col items-center relative shadow-[10px_10px_0px_0px_rgba(0,0,0,1)]"
      >
        <button
          id="close-akasha"
          class="absolute -top-4 -right-4 bg-red-500 text-white border-4 border-black px-4 py-2 font-black text-xl hover:bg-red-600 transition-colors z-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
