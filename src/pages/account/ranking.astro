                  </p>
                  <h2
                    id="akasha-name"
                    class="font-black text-4xl lg:text-5xl leading-none tracking-tight"
                  >
                    Usuario
                  </h2>
                  <p
                    id="akasha-faculty"
                    class="mt-2 inline-block text-xs font-black uppercase bg-[#d7fd48] text-black border-2 border-black px-2 py-1"
                  >
                    Sin Facultad
                  </p>
                </div>
                <div class="text-right font-black">
                  <p class="text-xs uppercase text-white/70">Niv.</p>
                  <p id="akasha-level" class="text-3xl text-[#d7fd48]">1</p>
                </div>
              </div>

              <div
                class="relative grow min-h-68 md:min-h-80 border-2 border-black bg-black/40 overflow-hidden"
              >
                <div
                  class="absolute inset-0 bg-linear-to-br from-green-500/20 via-transparent to-cyan-300/20"
                >
                </div>
                <img
                  id="akasha-avatar"
                  src="https://api.dicebear.com/7.x/avataaars/svg?seed=capy"
                  crossorigin="anonymous"
                  class="absolute bottom-0 left-1/2 -translate-x-1/2 w-52 h-52 md:w-64 md:h-64 object-cover drop-shadow-[0_10px_15px_rgba(0,0,0,0.5)]"
                />
                <div
                  class="absolute left-3 right-3 bottom-3 bg-black/70 border-2 border-white/50 p-2"
                >
                  <div
                    class="flex justify-between text-xs font-black uppercase mb-1"
                  >
                    <span>Progreso XP</span>
                    <span id="akasha-xp">0</span>
                  </div>
                  <div class="h-3 border border-white/70 bg-white/20">
                    <div
                      id="akasha-xp-bar"
                      class="h-full bg-[#d7fd48] transition-all duration-500"
                      style="width: 35%;"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="border-2 border-white/50 bg-black/35 p-4">
              <h3 class="font-black text-xl uppercase text-[#d7fd48] mb-3">
                Estadísticas
              </h3>
              <div class="space-y-2 text-sm md:text-base font-bold">
                <div class="flex justify-between border-b border-white/30 pb-1">
                  <span>Ranking Global</span><span id="akasha-rank">#--</span>
                </div>
                <div class="flex justify-between border-b border-white/30 pb-1">
                  <span>Misiones</span><span id="akasha-missions">0</span>
                </div>
                <div class="flex justify-between border-b border-white/30 pb-1">
                  <span>Racha Activa</span><span id="akasha-streak">0 días</span
                  >
                </div>
                <div class="flex justify-between border-b border-white/30 pb-1">
                  <span>Contribución Facult.</span><span id="akasha-contrib"
                    >0%</span
                  >
                </div>
                <div class="flex justify-between border-b border-white/30 pb-1">
                  <span>Actividad Semanal</span><span id="akasha-activity"
                    >Media</span
                  >
                </div>
              </div>

              <div class="mt-4 border-2 border-white/40 p-3">
                <p class="font-black uppercase text-xs text-white/70 mb-2">
                  Hexa Poder Capy
                </p>
                <div class="relative w-48 h-48 mx-auto">
                  <div
                    class="absolute inset-0 rounded-full border border-white/20"
                  >
                  </div>
                  <div
                    class="absolute inset-4 rounded-full border border-white/20"
                  >
                  </div>
                  <div
                    class="absolute inset-8 rounded-full border border-white/20"
                  >
                  </div>
                  <div class="absolute inset-0 grid place-items-center">
                    <div
                      class="w-36 h-36 bg-[#8CFFE1]/20 [clip-path:polygon(50%_0%,85%_20%,100%_50%,85%_80%,50%_100%,15%_80%,0%_50%,15%_20%)] border-2 border-[#8CFFE1]/70"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="border-2 border-white/50 bg-black/35 p-4">
              <h3 class="font-black text-xl uppercase text-[#8CFFE1] mb-3">
                Equipamiento Capy
              </h3>
              <div class="grid grid-cols-2 gap-3">
                <div class="border-2 border-[#d7fd48] bg-black/50 p-2 min-h-20">
                  <p class="text-[10px] uppercase font-black text-[#d7fd48]">
                    Insignia
                  </p>
                  <p class="font-bold text-sm mt-2">Líder Verde</p>
                </div>
                <div class="border-2 border-[#8CFFE1] bg-black/50 p-2 min-h-20">
                  <p class="text-[10px] uppercase font-black text-[#8CFFE1]">
                    Relic
                  </p>
                  <p class="font-bold text-sm mt-2">Mente Productiva</p>
                </div>
                <div class="border-2 border-[#ff9dcf] bg-black/50 p-2 min-h-20">
                  <p class="text-[10px] uppercase font-black text-[#ff9dcf]">
                    Título
                  </p>
                  <p class="font-bold text-sm mt-2">Capy Ciudadano</p>
                </div>
                <div class="border-2 border-white bg-black/50 p-2 min-h-20">
                  <p class="text-[10px] uppercase font-black text-white">
                    Estado
                  </p>
                  <p class="font-bold text-sm mt-2">Activo</p>
                </div>
              </div>

              <div class="mt-4 border-2 border-white/40 p-3 bg-black/40">
                <p class="text-xs font-black uppercase text-white/70">
                  Posición regional
                </p>
                <p
                  class="font-black text-2xl text-[#d7fd48]"
                  id="akasha-regional"
                >
                  Top 1%
                </p>
              </div>
            </div>
          </div>
        </div>

        <button
          id="download-akasha"
          class="w-full bg-[#8CFFE1] mt-6 py-4 font-black text-lg uppercase border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all flex justify-center items-center gap-2"
        >
          📸 DESCARGAR TARJETA
        </button>
      </div>
    </div>

    <!-- Sticky Bottom Card: TU POSICIÓN -->
    <div
      class="fixed bottom-20 md:bottom-8 right-4 md:right-8 z-50 transform hover:-translate-y-2 transition-transform"
    >
      <div
        id="sticky-trigger"
        class="bg-black border-4 border-white shadow-[8px_8px_0px_0px_rgba(139,92,246,1)] p-4 sm:p-6 flex items-center gap-4 sm:gap-6 active:translate-y-1 transition-all cursor-pointer hover:shadow-[4px_4px_0px_0px_rgba(139,92,246,1)]"
      >
        <div class="text-white">
          <p
            class="font-black text-xs uppercase tracking-widest leading-none mb-2 text-[#d7fd48]"
          >
            TU POSICIÓN GLOBAL
          </p>
          <p
            id="user-rank"
            class="font-black text-5xl sm:text-6xl leading-none drop-shadow-[2px_2px_0px_rgba(139,92,246,1)]"
          >
            #--
          </p>
        </div>
        <div class="h-16 sm:h-20 w-1 bg-[#d7fd48]"></div>
        <div class="text-white hidden sm:flex flex-col">
          <p
            class="font-black text-xs uppercase tracking-widest leading-none mb-2 text-[#8CFFE1]"
          >
            XP ACUMULADA
          </p>
          <p
            id="user-points-footer"
            class="font-black text-3xl sm:text-4xl leading-none"
          >
            0
          </p>
        </div>
      </div>
    </div>

    <script>
      import { initRanking } from "../../utils/rankingLogic.js";

      type RankingWindow = Window & {
        estado?: {
          datos?: {
            users?: {
              user?: Record<string, unknown>;
            };
          };
        };
        html2canvas?: (
          element: HTMLElement,
          options?: {
            useCORS?: boolean;
            backgroundColor?: string | null;
            scale?: number;
          },
        ) => Promise<HTMLCanvasElement>;
      };

      let rankingBooted = false;
      const setupAkasha = () => {
        const w = window as RankingWindow;
        const stickyCard =
          document.getElementById("sticky-trigger") ||
          document.querySelector(".fixed.bottom-20");
        const modal = document.getElementById("akasha-modal");
        const closeBtn = document.getElementById("close-akasha");
        const downloadBtn = document.getElementById("download-akasha");

        if (stickyCard && modal) {
          stickyCard.classList.add("cursor-pointer");
          stickyCard.onclick = () => {
            const u = (w.estado?.datos?.users?.user || {}) as {
              name?: string;
              points?: number;
              xp?: number;
              faculty_name?: string;
              level?: number;
              missions_completed?: number;
              streak_days?: number;
              faculty_contribution?: number;
            };
            const xp = Number(u.points || u.xp || 0);
            const rankText =
              document.getElementById("user-rank")?.textContent || "#1";

            const akashaName = document.getElementById("akasha-name");
            if (akashaName) akashaName.textContent = u.name || "CapyLover";

            const akashaRank = document.getElementById("akasha-rank");
            if (akashaRank) akashaRank.textContent = rankText;

            const akashaXp = document.getElementById("akasha-xp");
            if (akashaXp) akashaXp.textContent = `${xp} XP`;

            const akashaFaculty = document.getElementById("akasha-faculty");
            if (akashaFaculty)
              akashaFaculty.textContent = u.faculty_name || "Sin Facultad";

            const akashaLevel = document.getElementById("akasha-level");
            if (akashaLevel)
              akashaLevel.textContent = String(
                u.level || Math.max(1, Math.floor(xp / 150) + 1),
              );

            const akashaXpBar = document.getElementById("akasha-xp-bar");
            if (akashaXpBar) {
              const pct = Math.max(8, Math.min(100, ((xp % 150) / 150) * 100));
              akashaXpBar.style.width = `${pct}%`;
            }

            const akashaMissions = document.getElementById("akasha-missions");
            if (akashaMissions)
              akashaMissions.textContent = String(
                u.missions_completed || Math.floor(xp / 25),
              );

            const akashaStreak = document.getElementById("akasha-streak");
            if (akashaStreak)
              akashaStreak.textContent = `${u.streak_days || Math.max(1, Math.floor(xp / 100))} días`;

            const akashaContrib = document.getElementById("akasha-contrib");
            if (akashaContrib)
              akashaContrib.textContent = `${u.faculty_contribution || Math.max(5, Math.min(95, Math.floor((xp % 500) / 5)))}%`;

            const akashaActivity = document.getElementById("akasha-activity");
            if (akashaActivity)
              akashaActivity.textContent =
                xp > 1200 ? "Alta" : xp > 500 ? "Media" : "Inicial";

            const akashaRegional = document.getElementById("akasha-regional");
            if (akashaRegional)
              akashaRegional.textContent =
                xp > 1500 ? "Top 0.5%" : xp > 800 ? "Top 3%" : "Top 10%";

            const akashaAvatar = document.getElementById(
              "akasha-avatar",
            ) as HTMLImageElement | null;
            if (akashaAvatar) {
              akashaAvatar.src = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(u.name || "capy")}`;
            }

            modal.classList.remove("hidden");
            modal.style.display = "flex";
          };
        }

        if (closeBtn && modal) {
          closeBtn.onclick = () => {
            modal.classList.add("hidden");
            modal.style.display = "none";
          };
        }

        if (downloadBtn) {
          downloadBtn.onclick = () => {
            if (!w.html2canvas) {
              alert("Generador de imágenes no cargado");
              return;
            }

            const akashaCard = document.getElementById("akasha-card");
            if (!akashaCard) return;

            downloadBtn.textContent = "Generando...";
            w.html2canvas(akashaCard, {
              useCORS: true,
              backgroundColor: null,
              scale: 2,
            })
              .then((canvas) => {
                const link = document.createElement("a");
                link.download = "Mi-Tarjeta-CapyPay.png";
                link.href = canvas.toDataURL("image/png");
                link.click();
                downloadBtn.textContent = "📸 DESCARGAR TARJETA";
              })
              .catch(() => {
                downloadBtn.textContent = "❌ Error";
                setTimeout(() => {
                  downloadBtn.textContent = "📸 DESCARGAR TARJETA";
                }, 2000);
              });
          };
        }
      };

      const bootRanking = () => {
        if (rankingBooted) return;
        rankingBooted = true;
        initRanking();
      };

      document.addEventListener("astro:page-load", () => {
        bootRanking();
        setTimeout(setupAkasha, 400);
      });

      if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
      ) {
        bootRanking();
        setTimeout(setupAkasha, 400);
      }
    </script>
  </div>
  <script
    src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"
  ></script>
</MainLayout>
