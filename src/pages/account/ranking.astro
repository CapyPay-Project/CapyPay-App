        >

        <div
          id="akasha-card"
          class="w-full border-4 border-black bg-linear-to-r from-[#0b2a16] via-[#1f5130] to-[#103321] text-white p-4 md:p-6 relative overflow-hidden"
        >
          <div
            class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]"
