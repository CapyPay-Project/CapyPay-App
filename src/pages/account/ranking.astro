---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Ranking de Influencia | CapyPay" showSidebar={true}>
  <!-- Volver -->
  <a
    href="/dashboard"
    class="inline-flex w-max items-center gap-2 text-black bg-white hover:bg-[#d7fd48] transition-colors mb-4 group font-black uppercase tracking-wider text-sm border-2 border-black px-3 py-2 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 group-hover:-translate-x-1 transition-transform"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="3"
        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
    </svg>
    VOLVER
  </a>

  <!-- Header & Prize Banner -->
  <div
    class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-6 mb-10 border-b-[6px] border-black pb-8 relative"
  >
    <!-- Background Decorator -->
    <div
      class="absolute -right-4 -top-8 text-[#d7fd48] opacity-20 pointer-events-none"
      style="font-size: 15rem; font-family: 'Space Grotesk', sans-serif; z-index: 0; transform: rotate(-5deg);"
    >
      #1
    </div>

    <div class="relative z-10 w-full lg:w-auto">
      <div class="flex items-center gap-4 mb-2">
        <span
          class="bg-black text-white px-3 py-1 font-black text-sm tracking-widest border-2 border-black rotate-2 shadow-[2px_2px_0px_#d7fd48]"
          >TEMPORADA 1</span
        >
        <span
          class="bg-[#8b5cf6] text-white px-3 py-1 font-black text-sm tracking-widest border-2 border-black -rotate-2 shadow-[2px_2px_0px_#000]"
          >LIGA UNERG</span
        >
      </div>
      <h1
        class="flex flex-col items-start gap-1 text-5xl sm:text-6xl lg:text-7xl font-black text-black uppercase tracking-tighter relative z-30"
        style="font-family: 'Space Grotesk', sans-serif;"
      >
        <span class="relative z-30 drop-shadow-[4px_4px_0px_white]"
          >RANKING DE</span
        >
        <span
          class="bg-[#d7fd48] px-4 py-1 border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] relative z-20 -mt-1 sm:-mt-2 transform -rotate-1 hover:rotate-1 transition-transform cursor-crosshair"
          >INFLUENCIA</span
        >
      </h1>
    </div>

    <div
      class="bg-black text-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(215,253,73,1)] p-5 transform -rotate-1 hover:rotate-1 transition-transform w-full lg:w-auto z-10"
    >
      <p
        class="text-sm font-black uppercase tracking-widest text-[#8CFFE1] mb-1 flex items-center gap-2"
      >
        <span class="animate-pulse">🔥</span> PREMIO SEMANAL
        <span
          id="countdown-timer"
          class="ml-auto font-black text-[#d7fd48] bg-white/10 px-2 py-0.5 border-2 border-[#d7fd48]"
          >--d --h --m</span
        >
      </p>
      <p
        class="text-3xl lg:text-4xl font-black uppercase tracking-tight"
        style="font-family: 'Space Grotesk', sans-serif;"
      >
        10,000 BARAS + MERCH
      </p>
      <div class="flex gap-2">
        <button
          class="mt-4 bg-white text-black font-black uppercase text-xs px-3 py-1 border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-y-0.5 hover:shadow-none transition-all active:bg-gray-200"
          id="btn-ver-premios">VER PREMIOS</button
        >
        <a
          href="/account/shop"
          class="inline-block mt-4 bg-linear-to-r from-[#d7fd48] to-[#8CFFE1] text-black font-black uppercase text-xs px-3 py-1 border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-y-0.5 hover:shadow-none transition-all"
          >🛒 CAPYSHOP</a
        >
      </div>
    </div>
  </div>

  <div
    class="grid grid-cols-1 xl:grid-cols-3 gap-10 mb-16"
    style="font-family: 'Space Grotesk', sans-serif;"
  >
    <!-- Main Content (Podium + Leaderboard) -->
    <div class="xl:col-span-2 space-y-10 z-10">
      <!-- Central Control Toggle -->
      <div
        class="flex flex-col sm:flex-row mb-2 border-4 border-black max-w-lg mx-auto overflow-hidden shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] font-black"
      >
        <button
          id="tab-users"
          class="flex-1 py-3 text-xl bg-[#d7fd48] text-black sm:border-r-4 border-black uppercase active:bg-[#c4ec32] hover:bg-[#c4ec32] transition-colors"
          >ESTUDIANTES</button
        >
        <button
          id="tab-faculties"
          class="flex-1 py-3 text-xl bg-white text-black/50 uppercase hover:bg-gray-100 hover:text-black transition-colors"
          >FACULTADES</button
        >
      </div>

      <!-- Podium -->
      <div
        class="bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjgiPjxyZWN0IHdpZHRoPSI4IiBoZWlnaHQ9IjgiIGZpbGw9IiNmZmYiLz48Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0iI2QxZDVkYiIvPjwvc3ZnPg==')] border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-6 sm:px-12 pt-20 pb-8 sm:pb-8 sm:pt-24 relative overflow-visible mt-12 mb-12 sm:mb-16 group"
      >
        <h2
          class="absolute -top-5 left-6 bg-white border-4 border-black px-4 py-1 text-3xl font-black uppercase tracking-tighter shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] z-20 group-hover:rotate-2 transition-transform cursor-default"
        >
          EL PODIO
        </h2>

        <button
          id="btn-share-podium"
          class="absolute -top-5 right-6 bg-[#8b5cf6] text-white border-4 border-black px-3 py-1 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] z-20 font-black uppercase hover:-translate-y-1 hover:bg-[#7c3aed] active:translate-y-1 active:shadow-none transition-all hidden md:flex items-center gap-2"
        >
          🔗 <span class="hidden sm:inline">COMPARTIR</span>
        </button>

        <div
          id="podium-container"
          class="flex flex-col md:flex-row items-end justify-center gap-8 md:gap-8 pt-10 pb-4 transition-opacity duration-300 relative z-10 sm:mt-6"
        >
          <!-- #2 -->
          <div
            class="w-full md:w-[30%] bg-[#8CFFE1] border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] flex flex-col items-center p-4 relative order-2 md:order-1 hover:-translate-y-2 transition-transform h-auto md:h-75"
          >
            <div
              class="absolute -top-8 bg-black text-white px-4 py-1 text-2xl font-black border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] transform -rotate-2 z-20"
            >
              #2
            </div>
            <div
              id="rank2-icon"
              class="hidden w-20 h-20 border-4 border-black mb-4 mt-2 bg-white items-center justify-center text-4xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              🏛️
            </div>
            <img
              id="rank2-avatar"
              alt="Avatar"
              class="w-20 h-20 border-4 border-black mb-4 mt-2 bg-white object-cover rounded-none shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
              src="https://ui-avatars.com/api/?name=2&background=random"
            />
            <div
              class="flex flex-col items-center justify-end flex-1 w-full bg-white/40 border-[3px] border-black p-2 mt-auto"
            >
              <span
                id="rank2-name"
                class="font-black text-xl uppercase text-center truncate w-full"
                >...</span
              >
              <div
                class="bg-black text-[#8CFFE1] w-full text-center py-1 mt-2 border-2 border-black"
              >
                <span id="rank2-points" class="font-black text-2xl">0 XP</span>
              </div>
            </div>
          </div>

          <!-- #1 -->
          <div
            class="w-full md:w-[40%] bg-[#d7fd48] border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col items-center p-4 relative z-10 order-1 md:order-2 hover:-translate-y-4 transition-transform h-auto md:h-95 transform md:scale-105"
          >
            <div
              class="absolute -top-10 bg-black text-[#d7fd48] px-6 py-2 text-4xl font-black border-4 border-black shadow-[6px_6px_0px_0px_rgba(255,255,255,1)] transform rotate-1 z-20"
            >
              #1
            </div>
            <span
              class="material-symbols-outlined text-6xl text-black mb-2 absolute -top-16 block drop-shadow-[2px_2px_0px_white]"
              style="font-variation-settings: 'FILL' 1;">&#x1f451;</span
            >
            <div
              id="rank1-icon"
              class="hidden w-24 h-24 border-4 border-black mb-4 mt-4 bg-white items-center justify-center text-5xl shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
            >
              🏛️
            </div>
            <img
              id="rank1-avatar"
              alt="Avatar"
              class="w-28 h-28 border-4 border-black mb-4 mt-4 bg-white object-cover shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
              src="https://ui-avatars.com/api/?name=1&background=random"
            />
            <div
              class="flex flex-col items-center justify-end flex-1 w-full bg-white/50 border-4 border-black p-3 mt-auto"
            >
              <span
                id="rank1-name"
                class="font-black text-2xl uppercase text-center truncate w-full"
                >...</span
              >
              <div
                class="bg-black text-[#d7fd48] w-full text-center py-2 mt-2 border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(255,255,255,0.3)]"
              >
                <span id="rank1-points" class="font-black text-3xl sm:text-4xl"
                  >0 XP</span
                >
              </div>
            </div>
          </div>

          <!-- #3 -->
          <div
            class="w-full md:w-[30%] bg-[#8b5cf6] border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] flex flex-col items-center p-4 relative order-3 md:order-3 hover:-translate-y-2 transition-transform h-auto md:h-65"
          >
            <div
              class="absolute -top-6 bg-black text-white px-4 py-1 text-2xl font-black border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(215,253,73,1)] transform rotate-2 z-20"
            >
              #3
            </div>
            <div
              id="rank3-icon"
              class="hidden w-16 h-16 border-4 border-black mb-4 mt-2 bg-white items-center justify-center text-3xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              🏛️
            </div>
            <img
              id="rank3-avatar"
              alt="Avatar"
              class="w-16 h-16 border-4 border-black mb-4 mt-2 bg-white object-cover shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
              src="https://ui-avatars.com/api/?name=3&background=random"
            />
            <div
              class="flex flex-col items-center justify-end flex-1 w-full bg-black/20 border-[3px] border-black p-2 mt-auto"
            >
              <span
                id="rank3-name"
                class="font-black text-lg sm:text-xl uppercase text-white text-center truncate w-full"
                >...</span
              >
              <div
                class="bg-white text-black w-full text-center py-1 mt-1 border-[3px] border-black"
              >
                <span id="rank3-points" class="font-black text-xl">0 XP</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        id="giant-vs-bar-container"
        class="hidden border-4 border-black bg-black text-white shadow-[8px_8px_0px_0px_rgba(139,92,246,1)] p-5 sm:p-7 -mt-4"
      >
        <div
          class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-5"
        >
          <h3
            class="font-black text-3xl sm:text-4xl uppercase tracking-tighter leading-none"
          >
            GUERRA DE <span class="text-[#d7fd48]">FACULTADES</span>
          </h3>
          <span
            class="font-black uppercase text-xs sm:text-sm bg-[#d7fd48] text-black border-2 border-white px-3 py-1 w-max"
          >
            Actualización en tiempo real
          </span>
        </div>

        <div class="border-4 border-white bg-zinc-900 p-4 sm:p-5">
          <div
            class="flex items-center justify-between gap-3 mb-3 font-black uppercase text-xs sm:text-sm"
          >
            <span id="giant-top1-name" class="text-[#8CFFE1] truncate"
              >Facultad A</span
            >
            <span class="text-white text-xl">VS</span>
            <span
              id="giant-top2-name"
              class="text-[#ff9dcf] truncate text-right">Facultad B</span
            >
          </div>

          <div class="h-12 border-2 border-white overflow-hidden flex">
            <div
              id="giant-vs-bar-fill1"
              class="h-full bg-[#8CFFE1] text-black font-black text-xs sm:text-sm flex items-center pl-3 transition-all duration-700"
              style="width: 50%;"
            >
              50%
            </div>
            <div
              id="giant-vs-bar-fill2"
              class="h-full bg-[#8b5cf6] text-white font-black text-xs sm:text-sm flex items-center justify-end pr-3 transition-all duration-700"
              style="width: 50%;"
            >
              50%
            </div>
          </div>

          <div
            class="mt-3 flex items-center justify-between font-black text-sm sm:text-base"
          >
            <span id="giant-top1-pts" class="text-[#8CFFE1]">0 XP/h</span>
            <span id="giant-top2-pts" class="text-[#ff9dcf]">0 XP/h</span>
          </div>
        </div>
      </div>

      <!-- Leaderboard Table -->
      <div
        class="border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] overflow-hidden bg-white mt-12 md:mt-0"
      >
        <div
          id="ranking-list-title"
          class="bg-black text-[#8CFFE1] p-4 sm:p-5 font-black text-xl sm:text-2xl uppercase tracking-widest border-b-4 border-black flex justify-between items-center"
        >
          <span>RANKING GLOBAL</span>
          <span class="text-sm text-white bg-white/20 px-2 py-1">TOP 100</span>
        </div>
        <div
          id="ranking-list-container"
          class="divide-y-[3px] divide-black min-h-75 bg-[#fdfdfd]"
        >
          <!-- JS WILL INJECT ROWS HERE -->
        </div>
        <div
          id="ranking-pagination"
          class="hidden p-4 bg-gray-100 justify-between items-center border-t-4 border-black"
        >
          <button
            id="pag-prev"
            class="border-[3px] border-black bg-white px-3 sm:px-5 py-2 font-black uppercase text-lg shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all disabled:opacity-50 disabled:pointer-events-none"
            >&lt; ANT</button
          >
          <span
            id="pag-info"
            class="font-black text-xl bg-white border-[3px] border-black px-4 py-1 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
            >1/1</span
          >
          <button
            id="pag-next"
            class="border-[3px] border-black bg-[#d7fd48] px-3 sm:px-5 py-2 font-black uppercase text-lg shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all disabled:opacity-50 disabled:pointer-events-none"
            >SIG &gt;</button
          >
        </div>
      </div>
    </div>

    <!-- Sidebars -->
    <div class="space-y-10" id="sidebar-container">
      <div id="faculties-info-sidebar" class="hidden space-y-10">
        <div
          class="bg-white border-4 border-black p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transform md:-rotate-1"
        >
          <h3
            class="font-black text-2xl uppercase tracking-tighter mb-4 text-black bg-yellow-300 inline-block px-2 border-2 border-black"
          >
            Cómo se calcula
          </h3>
          <p class="font-bold text-sm text-gray-700 mb-2">
            Puntuación = <br /><span
              class="text-purple-600 bg-purple-100 px-1 border border-purple-600 rounded"
              >Total XP Facultades</span
            > / <span
              class="bg-blue-100 text-blue-600 px-1 border border-blue-600 rounded"
              >Total Estudiantes</span
            >
          </p>
          <ul class="list-disc pl-5 mt-4 text-sm font-bold space-y-2">
            <li>La guerra se equilibra por cantidad de estudiantes.</li>
            <li>Únete a ganar XP respondiendo quizes y comprando.</li>
            <li>El top se recalcula cada vez que entra una nueva actividad.</li>
            <li>Si hay empate, gana la facultad con más constancia semanal.</li>
          </ul>
          <div
            class="mt-4 border-2 border-black bg-black text-white p-3 text-xs font-bold leading-relaxed"
          >
            <p class="uppercase text-[#d7fd48] mb-2">Cómo funciona el evento</p>
            <p>1) Cada compra o misión suma XP personal.</p>
            <p>2) Ese XP también aporta al acumulado de tu facultad.</p>
            <p>3) El sistema divide por miembros activos para que sea justo.</p>
          </div>
        </div>
      </div>
      <div id="students-info-sidebar" class="space-y-10">
        <!-- Faculty Battle Card -->
        <div
          id="faculty-battle-summary"
          class="bg-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-6 -rotate-1 hover:rotate-1 transition-transform relative"
        >
          <!-- Decorator -->
          <div
            class="absolute -top-4 -right-4 bg-[#FF6B6B] border-[3px] border-black p-2 font-black text-white transform rotate-12 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] z-10 w-28 text-center text-sm"
          >
            EN CURSO
          </div>

          <h3
            class="font-black text-3xl sm:text-4xl uppercase mb-6 tracking-tighter leading-none pr-8"
          >
            COPA DE LAS <br /><span class="text-[#8b5cf6]">FACULTADES</span>
          </h3>

          <div class="space-y-6">
            <div
              id="battle-details-text"
              class="flex items-center justify-center font-black text-sm sm:text-base border-[3px] border-black bg-gray-100 p-3 text-center"
            >
              Calculando dominio por XP promedio...
            </div>

            <!-- Progress Bar Wrapper -->
            <div
              class="bg-black p-2 border-4 border-black shadow-[4px_4px_0px_0px_rgba(215,253,73,1)]"
            >
              <div
                id="battle-bar-container"
                class="h-14 border-[3px] border-white flex relative overflow-hidden"
              >
                <!-- JS Injects Bar Here -->
              </div>
            </div>
            <button
              class="w-full bg-[#8b5cf6] text-white py-4 font-black uppercase text-xl sm:text-2xl border-4 border-black hover:bg-[#d7fd48] hover:text-black hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-y-1 transition-all"
              onclick="document.getElementById('tab-faculties').click()"
            >
              VER RANKING
            </button>
            <div class="flex justify-center mt-2">
              <span
                class="text-center font-bold text-sm underline cursor-pointer hover:text-purple-500"
                onclick="alert('Sistema Justo: La Copa de las Facultades calcula la XP de todos tus compañeros y la divide entre los miembros activos. ¡Cada acción cuenta, sin importar el tamaño de tu facultad!');"
                >¿Cómo funciona la Copa?</span
              >
            </div>
          </div>
        </div>

        <!-- How to earn XP -->
        <div
          class="bg-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-6 rotate-1 hover:rotate-0 transition-transform bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjgiPjxyZWN0IHdpZHRoPSI4IiBoZWlnaHQ9IjgiIGZpbGw9IiNmZmYiLz48cmVjdCB3aWR0aD0iMSIgaGVpZ2h0PSIxIiBmaWxsPSIjZTVlN2ViIi8+PC9zdmc+')]"
        >
          <h3
            class="font-black text-2xl sm:text-3xl uppercase mb-6 border-b-4 border-black pb-4 flex items-center gap-3 cursor-pointer select-none group"
            id="btn-bendicion"
          >
            COMO SER UN <span
              class="bg-[#d7fd48] px-2 py-1 border-4 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] inline-block transform -rotate-3 group-hover:rotate-3 group-hover:scale-110 transition-all text-xl"
              >CAPY CIUDADANO</span
            >
          </h3>

          <ul class="space-y-4 font-bold text-lg sm:text-xl">
            <li
              class="flex items-center gap-4 p-3 bg-white border-[3px] border-black hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all"
              title="Escanea QR en zonas de reciclaje"
            >
              <span
                class="bg-[#d7fd48] text-black w-10 h-10 flex items-center justify-center border-[3px] border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-2xl shrink-0"
                >♻️</span
              >
              <span class="uppercase leading-tight"
                >CAMPUS<br /><span class="text-sm">LIMPIO</span></span
              >
            </li>
            <li
              class="flex items-center gap-4 p-3 bg-white border-[3px] border-black hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all"
              title="Realiza donaciones o divide deudas"
            >
              <span
                class="bg-[#8CFFE1] text-black w-10 h-10 flex items-center justify-center border-[3px] border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] text-2xl shrink-0"
                >🤝</span
              >
              <span class="uppercase leading-tight"
                >PAGOS<br /><span class="text-sm">SOLIDARIOS</span></span
              >
            </li>
            <li
