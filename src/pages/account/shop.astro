---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="CapyShop - Recompensas | CapyPay" showSidebar={true}>
  <!-- Glowing/Animated Background for the entire shop -->
  <div
    class="fixed inset-0 pointer-events-none z-0 overflow-hidden bg-[#fafafa]"
  >
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(#e5e7eb 2px, transparent 2px), linear-gradient(90deg, #e5e7eb 2px, transparent 2px), linear-gradient(#e5e7eb 1px, transparent 1px), linear-gradient(90deg, #e5e7eb 1px, transparent 1px); background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px; opacity: 0.8;"
    >
    </div>
  </div>

  <div class="relative z-10">
    <!-- Volver -->
    <a
      href="/account/ranking"
      class="inline-flex w-max items-center gap-2 text-black bg-white hover:bg-[#d7fd48] transition-colors mb-4 group font-black uppercase tracking-wider text-sm border-2 border-black px-3 py-2 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 group-hover:-translate-x-1 transition-transform"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="3"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      VOLVER
    </a>

    <!-- Header -->
    <div
      class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-6 mb-10 border-b-[6px] border-black pb-8"
    >
      <div class="relative">
        <h1
          class="flex flex-col items-start gap-1 text-5xl sm:text-6xl lg:text-7xl font-black text-black uppercase tracking-tighter relative z-30 group hover:animate-pulse"
          style="font-family: 'Space Grotesk', sans-serif;"
        >
          <span class="relative z-30 drop-shadow-[4px_4px_0px_white]">CAPY</span
          >
          <span
            class="bg-[#8CFFE1] px-4 py-1 border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] relative z-20 -mt-1 sm:-mt-2 transform -rotate-2 animate-bounce"
            >SHOP ✨</span
          >
        </h1>
        <p
          class="mt-6 text-xl font-bold bg-white inline-block border-2 border-black px-3 py-1 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
        >
          Canjea tus CapyPoints por premios exclusivos.
        </p>
      </div>

      <!-- Balance Banner -->
      <div
        class="bg-black text-white border-4 border-black shadow-[8px_8px_0px_0px_rgba(215,253,73,1)] p-5 transform rotate-1 hover:-rotate-1 transition-transform"
      >
        <p
          class="text-sm font-black uppercase tracking-widest text-[#8CFFE1] mb-1 flex items-center gap-2"
        >
          <span class="animate-pulse">💎</span> TUS CAPYPOINTS
        </p>
        <p
          class="text-4xl lg:text-5xl font-black uppercase tracking-tight"
          style="font-family: 'Space Grotesk', sans-serif;"
          id="user-reward-points"
        >
          0 Pts.
        </p>
      </div>
    </div>

    <div
      class="grid grid-cols-1 xl:grid-cols-4 gap-10 mb-16"
      style="font-family: 'Space Grotesk', sans-serif;"
    >
      <!-- Shop Items -->
      <div class="xl:col-span-3 space-y-10">
        <h2
          class="text-3xl font-black uppercase border-b-4 border-black pb-2 inline-block"
        >
          Artículos Disponibles
        </h2>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
          id="shop-container"
        >
          <!-- Renderizado dinámicamente -->
          <div
            class="bg-white border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-4 flex flex-col items-center animate-pulse"
          >
            <div class="w-full h-32 bg-gray-200 border-2 border-black mb-4">
            </div>
            <div class="w-3/4 h-6 bg-gray-200 mb-2"></div>
            <div class="w-1/2 h-6 bg-gray-200 mb-4"></div>
            <div class="w-full h-10 bg-gray-200 border-2 border-black mt-auto">
            </div>
          </div>
        </div>
      </div>

      <!-- EVENT MISSIONS -->
      <div
        class="xl:col-span-1 border-4 border-black bg-white shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-6 h-fit relative"
      >
        <div
          class="absolute -top-4 -right-4 bg-[#d7fd48] border-4 border-black px-3 py-1 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transform rotate-6 z-10 font-black"
        >
          MISIONES DE EVENTO
        </div>
        <h3
          id="missions-count"
          class="text-2xl font-black uppercase mb-6 flex items-center gap-2"
        >
          <span>??</span> DISPONIBLES
        </h3>
        <div class="space-y-4" id="event-missions">
          <!-- Dynamic Missions Go Here -->
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { gamificationService, authService } from "../../services/api.js";
  import { showToast } from "../../utils/toast.js";

  const SHOP_FALLBACK_IMAGE = "/images/cantina/sandwich.jpg";

  function resolveShopImageUrl(rawUrl: any) {
    const url = String(rawUrl || "").trim();
    if (!url) return SHOP_FALLBACK_IMAGE;

    // Evita rutas inexistentes legacy y placeholders externos inestables.
    if (url.startsWith("/images/shop/")) return SHOP_FALLBACK_IMAGE;
    if (url.includes("via.placeholder.com")) return SHOP_FALLBACK_IMAGE;

    return url;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const user = authService.getCurrentUser();
    if (user) {
      const pointsEl = document.getElementById("user-reward-points");
      if (pointsEl) {
        pointsEl.innerText = `${user.reward_points || 0} Pts.`;
      }

      gamificationService
        .getShopItems()
        .then((items: any) => {
          const container = document.getElementById("shop-container");
          if (!items || items.length === 0) {
            if (container)
              container.innerHTML = `<p class="text-gray-500 font-bold col-span-full">No hay artículos disponibles en este momento.</p>`;
            return;
          }
          if (container) {
            container.innerHTML = items
              .map((item: any, i: number) => {
                const colors = [
                  "bg-[#8CFFE1]",
                  "bg-[#d7fd48]",
                  "bg-[#FF90E8]",
                  "bg-[#FFC900]",
                  "bg-[#90A8FF]",
                ];
                const bgColor = colors[i % colors.length];
                const isOutOfStock =
                  item.stock !== null &&
                  item.stock !== undefined &&
                  item.stock <= 0;
                return `
            <div class="bg-white border-4 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] p-4 flex flex-col hover:-translate-y-1 hover:shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 group relative">
              ${isOutOfStock ? `<div class="absolute inset-0 bg-white/80 z-10 flex flex-col items-center justify-center backdrop-blur-sm"><span class="bg-black text-white font-black px-4 py-2 border-2 border-black transform -rotate-12 text-xl">AGOTADO</span></div>` : ""}
              <div class="w-full h-40 border-4 border-black mb-4 overflow-hidden ${bgColor} flex items-center justify-center relative">
                 <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white to-transparent"></div>
                 <img src="${resolveShopImageUrl(item.image_url)}" alt="${item.name}" class="max-h-[80%] object-contain group-hover:scale-125 transition-transform duration-500 drop-shadow-xl" onerror="this.onerror=null;this.src='${SHOP_FALLBACK_IMAGE}'" />
                 ${item.tier_requirement ? `<span class="absolute top-2 left-2 bg-black text-white text-[10px] uppercase font-black px-2 py-1 border-2 border-black tracking-widest shadow-[2px_2px_0px_0px_rgba(255,255,255,1)]">Nvl Min: ${item.tier_requirement}</span>` : ""}
                 ${item.stock !== null && item.stock !== undefined ? `<span class="absolute bottom-2 right-2 bg-white text-black text-xs font-black px-2 py-1 border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">Quedan ${item.stock}</span>` : `<span class="absolute bottom-2 right-2 bg-black text-white text-xs font-black px-2 py-1 border-2 border-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">∞ STOCK</span>`}
              </div>
              <h4 class="font-black text-xl uppercase mb-1 leading-tight tracking-tight">${item.name}</h4>
              <p class="text-xs text-gray-600 font-medium mb-4 min-h-[32px]">${item.description}</p>
              <button onclick="window.buyItem(${item.id}, ${item.cost})" class="${user.reward_points >= item.cost ? `${bgColor} hover:bg-black hover:text-white` : "bg-gray-200 opacity-50 cursor-not-allowed"} w-full text-black font-black uppercase py-3 border-4 border-black transition-colors mt-auto flex justify-between px-4 items-center">
                <span>COMPRAR</span> 
                <span class="bg-white text-black px-2 py-1 border-2 border-black text-xs">${item.cost} Pts.</span>
              </button>
            </div>
          `;
              })
              .join("");
          }
        })
        .catch((e: Error) => console.error(e));

      gamificationService
        .getEventMissions(user.id)
        .then((res: any) => {
          const missions = res.missions || res || [];
          // Filtering simple logic to show more "event" style ones, or at least style them differently.
          const container = document.getElementById("event-missions");
          const availableCount = document.getElementById("missions-count");
          if (availableCount)
            availableCount.innerText = `${missions.length} DISPONIBLES`;

          if (container) {
            if (!missions.length) {
              container.innerHTML = `<div class="bg-gray-100 p-6 border-4 border-black text-center"><p class="text-sm font-black text-gray-500 uppercase tracking-widest">No hay eventos activos.</p><span class="text-3xl mt-2 block">🤷</span></div>`;
              return;
            }
            container.innerHTML = missions
              .map((m: any, i: number) => {
                const isCompleted =
                  m.is_completed ||
                  m.completed ||
                  m.status === "completed" ||
                  m.status === "claimed";
                const isRare =
                  m.xp_reward > 20 ||
                  m.points_reward > 20 ||
                  (m.title || "").includes("RACHA"); // Just visual distinction
                const badgeClasses = isRare
                  ? "bg-[#FF90E8] text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
                  : "bg-[#d7fd48] text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]";

                return `
            <div class="group border-4 border-black p-4 mb-4 ${isCompleted ? "bg-gray-200 opacity-60 grayscale cursor-not-allowed" : "bg-white hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] selection"} transition-all duration-300 relative overflow-hidden">
              ${isCompleted ? `<div class="absolute inset-x-0 bottom-0 top-0 flex items-center justify-center bg-white/50 z-10"><span class="font-black text-3xl opacity-20 -rotate-12 border-4 border-black px-4 py-2">HECHO</span></div>` : ""}
              
              <div class="flex items-start justify-between mb-2">
                <span class="text-[10px] uppercase font-black tracking-widest bg-black text-white px-2 py-1">${isRare ? "ÉPICA ⭐" : "EVENTO ⚡"}</span>
                <span class="font-black text-lg ${isCompleted ? "grayscale" : ""}">${isCompleted ? "✅" : isRare ? "💎" : "🔥"}</span>
              </div>
              
              <h5 class="font-black text-base uppercase mb-1 leading-tight ${isCompleted ? "line-through text-gray-700" : "text-black"}">${m.title || "Misión Clandestina"}</h5>
              <p class="text-xs text-gray-600 mb-4 font-medium">${m.description || "Completa la tarea antes del tiempo límite."}</p>
              
              <div class="flex gap-2 text-[10px] font-black">
                <span class="inline-flex items-center px-3 py-1 border-2 border-black ${badgeClasses}">+${m.xp_reward || m.xpReward || m.points_reward || 0} XP</span>
                ${m.coins_reward || m.coinsReward ? `<span class="inline-flex items-center px-3 py-1 border-2 border-black bg-[#8CFFE1] text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">+${m.coins_reward || m.coinsReward} Pts.</span>` : ""}
              </div>
            </div>
            `;
              })
              .join("");
          }
        })
        .catch((e: Error) => console.error(e));
    }
  });

  (window as any).buyItem = async (id: number, cost: number) => {
    const user = authService.getCurrentUser();
    if (!user) return showToast("Error", "Debes iniciar sesión", "error");
    if (user.reward_points < cost)
      return showToast("Aviso", "No tienes Pts. suficientes.", "warning");
    try {
      const result = await gamificationService.buyShopItem(id, user.id);
      showToast("Éxito", "¡Compra exitosa! Consulta tu inventario.", "success");
      user.reward_points = result.newBalance || user.reward_points - cost;
      localStorage.setItem("capypay_user", JSON.stringify(user));
      const rewardPointsEl = document.getElementById("user-reward-points");
      if (rewardPointsEl) {
        rewardPointsEl.innerText = `${user.reward_points} Pts.`;
      }
      setTimeout(() => window.location.reload(), 1500);
    } catch (e: any) {
      console.error(e);
      showToast("Error", e.message || "Error en la compra", "error");
    }
  };
</script>
